
import kofmd.Kofmd

// Context — WHY the company publishes.
//
// The Company KofMD is parsed by the OFFICIAL KofMD library (pure-Kof
// libs/kofmd, vendored byte-identical under src/kofmd — see
// docs/gaps-and-reports.md GAP-2/GAP-5). The Publisher does NOT re-implement
// a markdown parser: it binds flat KofMD typed fields + list fields to an
// editorial model.
//
// KofMD is deliberately flat: `key: value` splits at the FIRST colon; a
// nested `monday: 09:00` under a `schedule:` field would parse as the STRING
// "monday: 09:00". The spec-legal encoding for schedules therefore uses
// KofMD LIST fields:
//
//   # publishing
//   timezone: America/Sao_Paulo
//   mode: autonomous
//
//   # schedule technical
//   days:
//     - monday
//     - wednesday
//     - friday
//   at: 09:00
//   topic: backend
//
// The section convention ("# <section>" opens a scope; the fields/list items
// under it belong to it) is a Publisher-side reading convention on top of
// inert KofMD prose headings (spec §6.5) — not a second language, not YAML
// in disguise.
//
// NOTE: a top-level function whose RETURN type nests a generic parameter
// (`Map<String, List<String>> f()`) fails to PARSE in 0.5.0-beta (PARSE075 —
// real Kof4j bug, minimal repro + full matrix in
// docs/gaps-and-reports.md BUG-4; a class method with the identical
// signature parses). The section reader therefore lives as an instance
// method of `CompanySections` (which also carries real state: the parsed
// doc) — this is a workaround pinned by a bug report, not ceremony.

record Company(
    String path,
    String name,
    String description,
    String audiencePrimary,
    String audienceSecondary,
    String positioning,
    String language,
    String tone,
    String mode,
    String timezone,
    String publishingTarget,
    List<String> products,
    List<String> topics,
    List<String> avoid,
    List<String> goals,
    List<Schedule> schedules,
    String sourceRepo,
    String sourceRef,
    List<String> guide,
    String digest,
    List<String> opinions,
    List<String> facts,
    List<Category> categories,
    List<String> diversity,
    List<String> authenticity,
    Int maxChars,
    Bool requireMaterial,
    List<String> principles,
    List<String> sources,
    GithubConfig github,
    // Research + retention policy (# editorial). Appended at the end so the
    // existing positional constructor call keeps its arguments in place.
    List<String> researchSources,
    Int researchMaxAgeHours,
    Int retentionRecords,
    Int retentionMaxGb,
    // The OPERATIONAL side of the profile: how the author reasons, how she
    // builds an argument, what she rejects, and the evidence ladder she
    // insists on. These are what make the profile a set of working rules
    // instead of a list of adjectives, and they are rendered into the
    // generation prompt (see Editorial.contextBrief/materialBrief).
    List<String> thinking,
    List<String> argumentation,
    List<String> rejects,
    List<String> evidenceRules)

// Explicit GitHub source config (# github section). The account is NEVER
// guessed: it must be declared, because the org name is not the author's
// personal account (acceptance §2.1).
record GithubConfig(String account, List<String> orgs, List<String> include, Bool enabled)

// One editorial category (a daily slot's ORIENTATION, not a hard template):
//   # category morning
//   clock: 06:00
//   label: opiniao e reflexao
//   function: contraponto
//   angle: uma tese propria sobre tecnologia, mercado ou IA que renda discordancia
// `clock` matches a schedule's `at` — that is how a slot finds its category.
// The angle is guidance injected into the prompt, never a required structure
// (acceptance: categories are flexible orientation, not four obligations).
//
// `function` names WHAT KIND of editorial job the slot does — one of
// projetos | noticias | contraponto | observacao. It is what topic PLANNING
// keys on: a news slot is fed from research items, a projects slot from real
// repository activity, and so on. An unrecognised/absent value falls back to
// the clock default, so an old profile keeps working unchanged.
record Category(String name, String clock, String label, String angle, String function)

// The category whose clock matches a schedule's `at` ("" -> none). Pure
// lookup, no persistence: the personal profile maps 06/12/15/18 to four
// categories without touching the Schedule entity/table.
Category? categoryAt(List<Category> cats, String clock) {
    for (var c in cats) {
        if (c.clock() == clock) {
            return c
        }
    }
    return null
}

// Is there editorial material to ground a post? Facts/opinions/topics, or a
// source repo (the KofLab facts flow). When a company declares
// require_material and has none, generation must SKIP — never fabricate.
Bool hasMaterial(Company c) {
    if (c.sourceRepo() != "") {
        return true
    }
    if (c.topics().size() > 0) {
        return true
    }
    if (c.opinions().size() > 0) {
        return true
    }
    if (c.facts().size() > 0) {
        return true
    }
    return false
}

// Expand $VAR / ${VAR} in config values (KofMD stays user-portable:
// `source_repo: $KOF_KOF4J_REPO` or a literal path both work). Unknown or
// empty vars expand to "" — honest, the loader will refuse to guess paths.
String expandVars(String v) {
    var out = ""
    var i = 0
    while (i < v.length) {
        var c = v.charAt(i)
        if (c == 36) {
            var j = i + 1
            var brace = false
            var more = j < v.length
            if (more && v.charAt(j) == 123) {
                brace = true
                j = j + 1
            }
            var name = ""
            while (j < v.length) {
                var d = v.charAt(j)
                var az = d >= 65
                if (az && d <= 90) {
                    name = name + v.substring(j, j + 1)
                    j = j + 1
                    continue
                }
                var az2 = d >= 97
                if (az2 && d <= 122) {
                    name = name + v.substring(j, j + 1)
                    j = j + 1
                    continue
                }
                var num = d >= 48
                if (num && d <= 57) {
                    name = name + v.substring(j, j + 1)
                    j = j + 1
                    continue
                }
                if (d == 95) {
                    name = name + v.substring(j, j + 1)
                    j = j + 1
                    continue
                }
                if (brace) {
                    if (d == 125) {
                        j = j + 1
                    }
                }
                break
            }
            var expanded = ""
            if (name != "") {
                var e = config.env(name)
                if (e != null) {
                    expanded = e
                }
            }
            out = out + expanded
            i = j
        } else {
            out = out + v.substring(i, i + 1)
            i = i + 1
        }
    }
    return out
}

String firstNonEmpty(String a, String b) {
    if (a != "") {
        return a
    }
    return b
}

String globalField(List<Section> secs, String key) {
    var found = ""
    for (var s in secs) {
        var i = 0
        while (i < s.keys().size()) {
            if (s.keys().get(i) == key) {
                found = s.values().get(i)
            }
            i = i + 1
        }
    }
    return found
}

List<String> globalList(List<Section> secs, String key) {
    var out = listOf<String>()
    for (var s in secs) {
        var i = 0
        while (i < s.lkeys().size()) {
            if (s.lkeys().get(i) == key) {
                out = splitItems(s.lvalues().get(i))
            }
            i = i + 1
        }
    }
    return out
}

String sectionField(List<Section> secs, String secName, String key) {
    for (var s in secs) {
        if (s.name() != secName) {
            continue
        }
        var i = 0
        while (i < s.keys().size()) {
            if (s.keys().get(i) == key) {
                return s.values().get(i)
            }
            i = i + 1
        }
    }
    return ""
}

List<String> sectionList(List<Section> secs, String secName, String key) {
    for (var s in secs) {
        if (s.name() != secName) {
            continue
        }
        var i = 0
        while (i < s.lkeys().size()) {
            if (s.lkeys().get(i) == key) {
                return splitItems(s.lvalues().get(i))
            }
            i = i + 1
        }
    }
    return listOf<String>()
}

// Stable content digest (FNV-1a 32-bit over the raw text) — the
// contextVersion stamped on every publication generated from this file.
String digestText(String text) {
    var h = 2166136261
    var i = 0
    while (i < text.length) {
        var c = text.charAt(i)
        h = h * 16777619
        h = h ^ c
        i = i + 1
    }
    var v = h
    if (v < 0) {
        v = -v
    }
    return "v" + strings.padLeft("" + v, 8, "0")
}

// One named KofMD section: scalar fields (keys/values) and list fields
// (lkeys/lvalues parallel). The name comes from the "# heading" text.
record Section(
    String name,
    List<String> keys,
    List<String> values,
    List<String> lkeys,
    List<String> lvalues)

// Section reader (see BUG-4 note above).
class CompanySections {
    KofmdDoc doc

    constructor(KofmdDoc doc) {
        this.doc = doc
    }

    List<Section> all() {
        var out = listOf<Section>()
        var current = ""
        var keys = listOf<String>()
        var values = listOf<String>()
        var lkeys = listOf<String>()
        var lvalues = listOf<String>()
        for (var b in doc.blocks()) {
            for (var p in b.prose()) {
                var t = p.trim()
                if (t.startsWith("# ")) {
                    if (current != "") {
                        out.add(Section(current, keys, values, lkeys, lvalues))
                    }
                    current = strings.toKebabCase(t.substring(2, t.length))
                    keys = listOf<String>()
                    values = listOf<String>()
                    lkeys = listOf<String>()
                    lvalues = listOf<String>()
                }
            }
            for (var fl in b.fields()) {
                if (current == "") {
                    continue
                }
                if (fl.value() != "") {
                    keys.add(fl.name())
                    values.add(fl.value())
                }
                if (fl.items().size() > 0) {
                    lkeys.add(fl.name())
                    lvalues.add(joinItems(fl.items()))
                }
            }
        }
        if (current != "") {
            out.add(Section(current, keys, values, lkeys, lvalues))
        }
        return out
    }
}

List<Schedule> schedulesOf(List<Section> secs, String defaultTz, String defaultMode) {
    var out = listOf<Schedule>()
    for (var s in secs) {
        if (!s.name().startsWith("schedule")) {
            continue
        }
        var name = "default"
        var dash = s.name().indexOf("-")
        if (dash >= 0) {
            name = s.name().substring(dash + 1, s.name().length)
        }
        var days = sectionList(secs, s.name(), "days")
        var day1 = sectionField(secs, s.name(), "day")
        if (day1 != "") {
            days.add(day1)
        }
        var every = sectionField(secs, s.name(), "every")
        var interval = 0
        if (every != "") {
            if (!strings.isNumeric(every)) {
                throw "schedule '" + name + "': 'every' must be a day count"
            }
            interval = toIntStr(every)
        }
        var tz = firstNonEmpty(sectionField(secs, s.name(), "timezone"), defaultTz)
        var mode = firstNonEmpty(sectionField(secs, s.name(), "mode"), defaultMode)
        if (mode == "") {
            mode = "assisted"
        }
        if (days.size() == 0 && interval == 0) {
            throw "schedule '" + name + "': needs 'days' (list) or 'every' (interval days)"
        }
        var at = sectionField(secs, s.name(), "at")
        var clock = parseClock(at)
        if (clock < 0) {
            throw "schedule '" + name + "': invalid 'at' '" + at + "' (expected HH:MM)"
        }
        var anchor = sectionField(secs, s.name(), "anchor")
        for (var d in days) {
            if (weekdayFromName(d) < 0) {
                throw "schedule '" + name + "': unknown day '" + d + "'"
            }
        }
        var topic = sectionField(secs, s.name(), "topic")
        var target = sectionField(secs, s.name(), "target")
        out.add(Schedule(name, joinedOf(days), interval, anchor, at, tz, topic, mode, target, "active", "", "", "", ""))
    }
    return out
}

// Editorial categories: sections named "# category <nome>" carrying clock
// (HH:MM, required), label and angle. The clock is the JOIN KEY to a schedule.
List<Category> categoriesOf(List<Section> secs) {
    var out = listOf<Category>()
    for (var s in secs) {
        if (!s.name().startsWith("category")) {
            continue
        }
        var name = "default"
        var dash = s.name().indexOf("-")
        if (dash >= 0) {
            name = s.name().substring(dash + 1, s.name().length)
        }
        var clock = sectionField(secs, s.name(), "clock")
        if (clock == "" || parseClock(clock) < 0) {
            throw "category '" + name + "': campo 'clock' obrigatorio no formato HH:MM"
        }
        var job = sectionField(secs, s.name(), "function")
        if (!validPlanFunction(job)) {
            job = defaultPlanFunction(clock)
        }
        out.add(Category(name, clock, sectionField(secs, s.name(), "label"), sectionField(secs, s.name(), "angle"), job))
    }
    return out
}

// GitHub source config (# github section). The account is DECLARED, never
// inferred: `account` is the author's PERSONAL login (evidence-verified
// separately by `kof-publisher github`), `orgs` are organisations she
// contributes to (separate identities, §2.1), `include` optionally narrows
// the repo set. Absent section => disabled: no network, no digest.
GithubConfig githubConfigOf(List<Section> secs) {
    var account = sectionField(secs, "github", "account")
    var orgs = sectionList(secs, "github", "orgs")
    var include = sectionList(secs, "github", "include")
    var enabled = sectionField(secs, "github", "enabled") == "true"
    if (account == "" && orgs.size() == 0) {
        enabled = false
    }
    return GithubConfig(account, orgs, include, enabled)
}

// Parse a company .md (KofMD) file into the editorial model. Honest String
// errors on anything structural — no silent defaults for identity fields.
Company loadCompany(String path) {
    var f = File(path)
    var raw = f.readText()
    if (raw == null) {
        throw "company file not readable: " + path
    }
    var tool = KofmdTool()
    var doc = tool.parse(raw)
    var schemas = tool.parseSchemas(raw)
    var companySchema = findSchema(schemas, "Company")
    if (companySchema != null) {
        var diags = tool.validateDoc(doc, companySchema)
        if (diags.size() > 0) {
            throw "company.kofmd schema: " + diags.get(0)
        }
    }
    var secs = CompanySections(doc).all()
    var name = globalField(secs, "name")
    if (name == "") {
        throw "company.kofmd: field 'name' is required (section # company)"
    }
    var mode = firstNonEmpty(sectionField(secs, "publishing", "mode"), globalField(secs, "mode"))
    if (mode != "" && mode != "assisted" && mode != "autonomous") {
        throw "company.kofmd: publishing mode '" + mode + "' invalid (use assisted|autonomous)"
    }
    // Timezone must be explicit — the Publisher never assumes UTC silently.
    var tz = firstNonEmpty(sectionField(secs, "publishing", "timezone"), globalField(secs, "timezone"))
    if (tz == "") {
        throw "company.kofmd: publishing.timezone is required (explicit IANA zone, e.g. America/Sao_Paulo)"
    }
    if (!isValidZone(tz)) {
        throw "company.kofmd: invalid timezone '" + tz + "' (use e.g. America/Sao_Paulo)"
    }
    if (!validOffset(zoneOffsetHours(tz, time.now()))) {
        throw "company.kofmd: timezone '" + tz + "' unavailable on this runtime — refusing to assume UTC"
    }
    var target0 = firstNonEmpty(sectionField(secs, "publishing", "target"), globalField(secs, "target"))
    // Editorial policy (# editorial): size limit, material gate, diversity
    // strategy and authenticity rules — explicit, easy to maintain, no
    // separate framework.
    var maxChars = 0
    var rawMax = sectionField(secs, "editorial", "max_chars")
    if (rawMax != "" && strings.isNumeric(rawMax)) {
        maxChars = toIntStr(rawMax)
    }
    var requireMaterial = sectionField(secs, "editorial", "require_material") == "true"
    // Research policy: which sources to consult before choosing topics, and how
    // old a story may be and still pass as current. `0` (or absent) means no
    // explicit window — the age is still RECORDED and reported, never assumed.
    var researchSources = sectionList(secs, "editorial", "research")
    var researchMaxAgeHours = 0
    var rawAge = sectionField(secs, "editorial", "research_max_age_hours")
    if (rawAge != "" && strings.isNumeric(rawAge)) {
        researchMaxAgeHours = toIntStr(rawAge)
    }
    // Retention: a record count (how many editorial records to keep) and a
    // storage ceiling in GB (the safety valve, not a target).
    var retentionRecords = 10000
    var rawRet = sectionField(secs, "editorial", "retention_records")
    if (rawRet != "" && strings.isNumeric(rawRet)) {
        retentionRecords = toIntStr(rawRet)
    }
    var retentionMaxGb = 20
    var rawGb = sectionField(secs, "editorial", "retention_max_gb")
    if (rawGb != "" && strings.isNumeric(rawGb)) {
        retentionMaxGb = toIntStr(rawGb)
    }
    return Company(
        path,
        name,
        globalField(secs, "description"),
        globalField(secs, "audience_primary"),
        globalField(secs, "audience_secondary"),
        globalField(secs, "positioning"),
        globalField(secs, "language"),
        globalField(secs, "tone"),
        mode,
        tz,
        target0,
        globalList(secs, "products"),
        globalList(secs, "topics"),
        globalList(secs, "avoid"),
        globalList(secs, "goals"),
        schedulesOf(secs, tz, mode),
        expandVars(firstNonEmpty(sectionField(secs, "publishing", "source_repo"), globalField(secs, "source_repo"))),
        firstNonEmpty(sectionField(secs, "publishing", "source_ref"), globalField(secs, "source_ref")),
        globalList(secs, "guide"),
        digestText(raw),
        globalList(secs, "opinions"),
        globalList(secs, "facts"),
        categoriesOf(secs),
        sectionList(secs, "editorial", "diversity"),
        sectionList(secs, "editorial", "authenticity"),
        maxChars,
        requireMaterial,
        globalList(secs, "principles"),
        globalList(secs, "sources"),
        githubConfigOf(secs),
        researchSources,
        researchMaxAgeHours,
        retentionRecords,
        retentionMaxGb,
        globalList(secs, "thinking"),
        globalList(secs, "argumentation"),
        globalList(secs, "rejects"),
        globalList(secs, "evidence"))
}

KofmdSchema? findSchema(List<KofmdSchema> schemas, String name) {
    for (var s in schemas) {
        if (s.name() == name) {
            return s
        }
    }
    return null
}
