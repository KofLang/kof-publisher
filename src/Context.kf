
import kofmd.Kofmd

// Context — WHY the company publishes.
//
// The Company KofMD is parsed by the OFFICIAL KofMD library (pure-Kof
// libs/kofmd, vendored byte-identical under src/kofmd — see
// docs/gaps-and-reports.md GAP-2/GAP-5). The Publisher does NOT re-implement
// a markdown parser: it binds flat KofMD typed fields + list fields to an
// editorial model.
//
// KofMD is deliberately flat: `key: value` splits at the FIRST colon; a
// nested `monday: 09:00` under a `schedule:` field would parse as the STRING
// "monday: 09:00". The spec-legal encoding for schedules therefore uses
// KofMD LIST fields:
//
//   # publishing
//   timezone: America/Sao_Paulo
//   mode: autonomous
//
//   # schedule technical
//   days:
//     - monday
//     - wednesday
//     - friday
//   at: 09:00
//   topic: backend
//
// The section convention ("# <section>" opens a scope; the fields/list items
// under it belong to it) is a Publisher-side reading convention on top of
// inert KofMD prose headings (spec §6.5) — not a second language, not YAML
// in disguise.
//
// NOTE: a top-level function whose RETURN type nests a generic parameter
// (`Map<String, List<String>> f()`) fails to PARSE in 0.5.0-beta (PARSE075 —
// real Kof4j bug, minimal repro + full matrix in
// docs/gaps-and-reports.md BUG-4; a class method with the identical
// signature parses). The section reader therefore lives as an instance
// method of `CompanySections` (which also carries real state: the parsed
// doc) — this is a workaround pinned by a bug report, not ceremony.

record Company(
    String path,
    String name,
    String description,
    String audiencePrimary,
    String audienceSecondary,
    String positioning,
    String language,
    String tone,
    String mode,
    String timezone,
    String publishingTarget,
    List<String> products,
    List<String> topics,
    List<String> avoid,
    List<String> goals,
    List<Schedule> schedules,
    String sourceRepo,
    String sourceRef,
    List<String> guide,
    String digest,
    List<String> opinions,
    List<String> facts,
    List<Category> categories,
    List<String> diversity,
    List<String> authenticity,
    Int maxChars,
    Bool requireMaterial,
    List<String> principles,
    List<String> sources,
    GithubConfig github,
    // Research + retention policy (# editorial). Appended at the end so the
    // existing positional constructor call keeps its arguments in place.
    List<String> researchSources,
    Int researchMaxAgeHours,
    Int retentionRecords,
    Int retentionMaxGb,
    // The OPERATIONAL side of the profile: how the author reasons, how she
    // builds an argument, what she rejects, and the evidence ladder she
    // insists on. These are what make the profile a set of working rules
    // instead of a list of adjectives, and they are rendered into the
    // generation prompt (see Editorial.contextBrief/materialBrief).
    List<String> thinking,
    List<String> argumentation,
    List<String> rejects,
    List<String> evidenceRules,
    // PRIMARY-source feeds (# editorial research_feeds). Appended at the end so
    // the existing positional constructor call keeps its arguments in place.
    List<String> researchFeeds,
    // SUBJECT taxonomy (# editorial subjects): "nome: palavra1, palavra2".
    // A recurring subject (IA, arquitetura, legado...) is what "nao da para
    // falar disso todo dia" is about — a level ABOVE the thesis. Two posts can
    // argue different things and still be the same subject, which is exactly
    // what the thesis comparison cannot see. Declared in the profile so the
    // author owns the taxonomy instead of the code guessing it.
    List<String> subjects,
    // ---- PERSONALITY (see docs/personalidade.md) ----
    // The author's own identity, psychology, emotional profile and editorial
    // engine, all parsed from the SAME KofMD the rest of the profile comes
    // from. Grouped into a record instead of another twenty flat fields: the
    // `Company` record is already long and these travel together. Appended
    // LAST so the positional constructor call keeps its arguments in place.
    Profile profile)

// One emotional state the author's writing can carry, and what in a subject
// raises it:
//   # emotional_profile
//   states:
//     - entusiasmo: 2, solucao elegante, maquina antiga que volta a funcionar
//
// `level` is the base intensity (0..5) when the state fires; `triggers` are the
// words that make it fire on a given subject. Both come from the profile — the
// code never guesses an emotion.
record EmotionState(String name, Int level, List<String> triggers)

// A technical domain and the author's own angle on it:
//   - compiladores: 2, o que a escolha de design custa em quem mantem
// `level` is the domain's own baseline intensity: an unfamiliar subject gets
// 0, a familiar domain gets this.
record Domain(String name, Int level, String angle)

// One row of the emotion ladder (`emotional_profile.levels`, level 0..5).
record ToneLevel(Int level, String name, String direction)

// The personality block: identity, psychology, emotion, voice and the
// editorial engine, all read from the author's KofMD. Every field has a
// declared fallback to the pre-personality layout (see `resolveSection`), so a
// profile written before 2026-11 keeps working — but `profile.origin` records
// WHICH of the two each section was read from, and `publisher check` prints it.
record Profile(
    Bool authored,
    List<String> background,
    List<String> values,
    List<String> personality,
    String profilePath,
    String voiceLanguage,
    String voiceTone,
    String domainDescription,
    List<ToneLevel> toneLevels,
    List<EmotionState> states,
    List<String> emotionRules,
    List<Domain> domains,
    List<String> industryPositions,
    List<String> teachingPositions,
    List<String> projects,
    List<String> engineQuestions,
    List<String> engineAvoidForms,
    List<String> formats,
    List<String> memoryAspects,
    List<String> signaturePhrases,
    List<String> expressionBanks,
    List<String> rhythmRules,
    List<String> clicheStructures,
    List<String> notLike,
    List<String> strongLanguageRules,
    Int strongLevels,
    List<String> reviewChecks,
    List<String> reviewNeutralizeForbidden,
    List<String> restrictions,
    // The author's recurring MOTIFS: the angle she brings to any subject, the
    // criterion she judges by, the thing she always notices. One of these
    // enters EVERY post, including a level-0 one, so the text is recognisably
    // hers even when the subject raises no emotion. They are stances, never
    // episodes: "eu olho o custo de manutencao antes da novidade", not "eu
    // passei a semana fazendo X".
    List<String> signatureMotifs,
    String platformLinkedin,
    String platformEnois,
    String platformOther,
    // section name -> "profile" (declared in the KofMD) or "fallback:<where>".
    // Printed by `publisher check`; a silent default is what this prevents.
    List<String> origin)

// The emotion+domain picture of one subject, computed WITHOUT a model call
// (Editorial.editorialDirective). Printed in the log and in `plan` so the
// author can see WHY a post was written at that intensity.
record EditorialFrame(
    String domain,
    Int baseLevel,
    String emotion,
    Int level,
    String format,
    String opinion,
    String relation,
    Bool neutral,
    // The author's signature motif for THIS post: chosen from
    // `# signature motifs`, it enters every post including a level-0 one.
    String motif)

// Explicit GitHub source config (# github section). The account is NEVER
// guessed: it must be declared, because the org name is not the author's
// personal account (acceptance §2.1).
record GithubConfig(String account, List<String> orgs, List<String> include, Bool enabled,
    // Forks the author actively develops. The blanket fork rule exists to skip
    // third-party code; a fork she pushes to is her own work, so declaring it
    // here is an explicit override that does NOT restrict the rest of the set
    // (which is what `include` would do). Appended LAST so existing positional
    // constructor calls keep their arguments in place.
    List<String> ownForks)

// One editorial category (a daily slot's ORIENTATION, not a hard template):
//   # category morning
//   clock: 06:00
//   label: opiniao e reflexao
//   function: contraponto
//   angle: uma tese propria sobre tecnologia, mercado ou IA que renda discordancia
// `clock` matches a schedule's `at` — that is how a slot finds its category.
// The angle is guidance injected into the prompt, never a required structure
// (acceptance: categories are flexible orientation, not four obligations).
//
// `function` names WHAT KIND of editorial job the slot does — one of
// projetos | noticias | contraponto | observacao. It is what topic PLANNING
// keys on: a news slot is fed from research items, a projects slot from real
// repository activity, and so on. An unrecognised/absent value falls back to
// the clock default, so an old profile keeps working unchanged.
record Category(String name, String clock, String label, String angle, String function)

// The category whose clock matches a schedule's `at` ("" -> none). Pure
// lookup, no persistence: the personal profile maps 06/12/15/18 to four
// categories without touching the Schedule entity/table.
Category? categoryAt(List<Category> cats, String clock) {
    for (var c in cats) {
        if (c.clock() == clock) {
            return c
        }
    }
    return null
}

// Is there editorial material to ground a post? Facts/opinions/topics, or a
// source repo (the KofLab facts flow). When a company declares
// require_material and has none, generation must SKIP — never fabricate.
Bool hasMaterial(Company c) {
    if (c.sourceRepo() != "") {
        return true
    }
    if (c.topics().size() > 0) {
        return true
    }
    if (c.opinions().size() > 0) {
        return true
    }
    if (c.facts().size() > 0) {
        return true
    }
    return false
}

// Expand $VAR / ${VAR} in config values (KofMD stays user-portable:
// `source_repo: $KOF_KOF4J_REPO` or a literal path both work). Unknown or
// empty vars expand to "" — honest, the loader will refuse to guess paths.
String expandVars(String v) {
    var out = ""
    var i = 0
    while (i < v.length) {
        var c = v.charAt(i)
        if (c == 36) {
            var j = i + 1
            var brace = false
            var more = j < v.length
            if (more && v.charAt(j) == 123) {
                brace = true
                j = j + 1
            }
            var name = ""
            while (j < v.length) {
                var d = v.charAt(j)
                var az = d >= 65
                if (az && d <= 90) {
                    name = name + v.substring(j, j + 1)
                    j = j + 1
                    continue
                }
                var az2 = d >= 97
                if (az2 && d <= 122) {
                    name = name + v.substring(j, j + 1)
                    j = j + 1
                    continue
                }
                var num = d >= 48
                if (num && d <= 57) {
                    name = name + v.substring(j, j + 1)
                    j = j + 1
                    continue
                }
                if (d == 95) {
                    name = name + v.substring(j, j + 1)
                    j = j + 1
                    continue
                }
                if (brace) {
                    if (d == 125) {
                        j = j + 1
                    }
                }
                break
            }
            var expanded = ""
            if (name != "") {
                var e = config.env(name)
                if (e != null) {
                    expanded = e
                }
            }
            out = out + expanded
            i = j
        } else {
            out = out + v.substring(i, i + 1)
            i = i + 1
        }
    }
    return out
}

String firstNonEmpty(String a, String b) {
    if (a != "") {
        return a
    }
    return b
}

String globalField(List<Section> secs, String key) {
    var found = ""
    for (var s in secs) {
        var i = 0
        while (i < s.keys().size()) {
            if (s.keys().get(i) == key) {
                found = s.values().get(i)
            }
            i = i + 1
        }
    }
    return found
}

List<String> globalList(List<Section> secs, String key) {
    var out = listOf<String>()
    for (var s in secs) {
        var i = 0
        while (i < s.lkeys().size()) {
            if (s.lkeys().get(i) == key) {
                out = splitItems(s.lvalues().get(i))
            }
            i = i + 1
        }
    }
    return out
}

String sectionField(List<Section> secs, String secName, String key) {
    for (var s in secs) {
        if (s.name() != secName) {
            continue
        }
        var i = 0
        while (i < s.keys().size()) {
            if (s.keys().get(i) == key) {
                return s.values().get(i)
            }
            i = i + 1
        }
    }
    return ""
}

List<String> sectionList(List<Section> secs, String secName, String key) {
    for (var s in secs) {
        if (s.name() != secName) {
            continue
        }
        var i = 0
        while (i < s.lkeys().size()) {
            if (s.lkeys().get(i) == key) {
                return splitItems(s.lvalues().get(i))
            }
            i = i + 1
        }
    }
    return listOf<String>()
}

// Stable content digest (FNV-1a 32-bit over the raw text) — the
// contextVersion stamped on every publication generated from this file.
String digestText(String text) {
    var h = 2166136261
    var i = 0
    while (i < text.length) {
        var c = text.charAt(i)
        h = h * 16777619
        h = h ^ c
        i = i + 1
    }
    var v = h
    if (v < 0) {
        v = -v
    }
    return "v" + strings.padLeft("" + v, 8, "0")
}

// One named KofMD section: scalar fields (keys/values) and list fields
// (lkeys/lvalues parallel). The name comes from the "# heading" text.
record Section(
    String name,
    List<String> keys,
    List<String> values,
    List<String> lkeys,
    List<String> lvalues)

// Section reader (see BUG-4 note above).
class CompanySections {
    KofmdDoc doc

    constructor(KofmdDoc doc) {
        this.doc = doc
    }

    List<Section> all() {
        var out = listOf<Section>()
        var current = ""
        var keys = listOf<String>()
        var values = listOf<String>()
        var lkeys = listOf<String>()
        var lvalues = listOf<String>()
        for (var b in doc.blocks()) {
            for (var p in b.prose()) {
                var t = p.trim()
                if (t.startsWith("# ")) {
                    if (current != "") {
                        out.add(Section(current, keys, values, lkeys, lvalues))
                    }
                    current = strings.toKebabCase(t.substring(2, t.length))
                    keys = listOf<String>()
                    values = listOf<String>()
                    lkeys = listOf<String>()
                    lvalues = listOf<String>()
                }
            }
            for (var fl in b.fields()) {
                if (current == "") {
                    continue
                }
                if (fl.value() != "") {
                    keys.add(fl.name())
                    values.add(fl.value())
                }
                if (fl.items().size() > 0) {
                    lkeys.add(fl.name())
                    lvalues.add(joinItems(fl.items()))
                }
            }
        }
        if (current != "") {
            out.add(Section(current, keys, values, lkeys, lvalues))
        }
        return out
    }
}

List<Schedule> schedulesOf(List<Section> secs, String defaultTz, String defaultMode) {
    var out = listOf<Schedule>()
    for (var s in secs) {
        if (!s.name().startsWith("schedule")) {
            continue
        }
        var name = "default"
        var dash = s.name().indexOf("-")
        if (dash >= 0) {
            name = s.name().substring(dash + 1, s.name().length)
        }
        var days = sectionList(secs, s.name(), "days")
        var day1 = sectionField(secs, s.name(), "day")
        if (day1 != "") {
            days.add(day1)
        }
        var every = sectionField(secs, s.name(), "every")
        var interval = 0
        if (every != "") {
            if (!strings.isNumeric(every)) {
                throw "schedule '" + name + "': 'every' must be a day count"
            }
            interval = toIntStr(every)
        }
        var tz = firstNonEmpty(sectionField(secs, s.name(), "timezone"), defaultTz)
        var mode = firstNonEmpty(sectionField(secs, s.name(), "mode"), defaultMode)
        if (mode == "") {
            mode = "assisted"
        }
        if (days.size() == 0 && interval == 0) {
            throw "schedule '" + name + "': needs 'days' (list) or 'every' (interval days)"
        }
        var at = sectionField(secs, s.name(), "at")
        var clock = parseClock(at)
        if (clock < 0) {
            throw "schedule '" + name + "': invalid 'at' '" + at + "' (expected HH:MM)"
        }
        var anchor = sectionField(secs, s.name(), "anchor")
        for (var d in days) {
            if (weekdayFromName(d) < 0) {
                throw "schedule '" + name + "': unknown day '" + d + "'"
            }
        }
        var topic = sectionField(secs, s.name(), "topic")
        var target = sectionField(secs, s.name(), "target")
        out.add(Schedule(name, joinedOf(days), interval, anchor, at, tz, topic, mode, target, "active", "", "", "", ""))
    }
    return out
}

// Editorial categories: sections named "# category <nome>" carrying clock
// (HH:MM, required), label and angle. The clock is the JOIN KEY to a schedule.
List<Category> categoriesOf(List<Section> secs) {
    var out = listOf<Category>()
    for (var s in secs) {
        if (!s.name().startsWith("category")) {
            continue
        }
        var name = "default"
        var dash = s.name().indexOf("-")
        if (dash >= 0) {
            name = s.name().substring(dash + 1, s.name().length)
        }
        var clock = sectionField(secs, s.name(), "clock")
        if (clock == "" || parseClock(clock) < 0) {
            throw "category '" + name + "': campo 'clock' obrigatorio no formato HH:MM"
        }
        var job = sectionField(secs, s.name(), "function")
        if (!validPlanFunction(job)) {
            job = defaultPlanFunction(clock)
        }
        out.add(Category(name, clock, sectionField(secs, s.name(), "label"), sectionField(secs, s.name(), "angle"), job))
    }
    return out
}

// GitHub source config (# github section). The account is DECLARED, never
// inferred: `account` is the author's PERSONAL login (evidence-verified
// separately by `kof-publisher github`), `orgs` are organisations she
// contributes to (separate identities, §2.1), `include` optionally narrows
// the repo set. Absent section => disabled: no network, no digest.
GithubConfig githubConfigOf(List<Section> secs) {
    var account = sectionField(secs, "github", "account")
    var orgs = sectionList(secs, "github", "orgs")
    var include = sectionList(secs, "github", "include")
    var enabled = sectionField(secs, "github", "enabled") == "true"
    if (account == "" && orgs.size() == 0) {
        enabled = false
    }
    return GithubConfig(account, orgs, include, enabled, sectionList(secs, "github", "own_forks"))
}

// ---- PERSONALITY parsing ----
//
// Every helper below returns BOTH what it read and where it read it from, so
// `publisher check` can print "esta secao veio do perfil" instead of letting a
// fallback hide a typo. Fallbacks are the PRE-PERSONALITY layout of the same
// file — an old profile keeps producing the same behaviour, and a new one adds
// to it.

Bool sectionDeclared(List<Section> secs, String name) {
    for (var s in secs) {
        if (s.name() == name) {
            return true
        }
    }
    return false
}

// First non-empty list: the new section when declared, else the fallback.
// `originOut` stays empty — the caller records the decision.
List<String> listOr(List<Section> secs, String section, String key, List<Section> fallbackSecs, String fallbackSection, String fallbackKey) {
    var v = sectionList(secs, section, key)
    if (v.size() > 0) {
        return v
    }
    if (fallbackSection == "") {
        return v
    }
    return sectionList(fallbackSecs, fallbackSection, fallbackKey)
}

Int intOrZero(String raw) {
    if (raw != "" && strings.isNumeric(raw)) {
        return toIntStr(raw)
    }
    return 0
}

// "entusiasmo: 2, solucao elegante, maquina antiga" -> EmotionState.
// The level is REQUIRED: an entry whose level is not 0..5 is a configuration
// error, not something to skip silently.
EmotionState parseState(String raw, String where) {
    var colon = raw.indexOf(":")
    if (colon <= 0) {
        throw "personalidade: " + where + ": estado '" + raw + "' sem nivel (formato 'nome: nivel, gatilho, gatilho')"
    }
    var name = raw.substring(0, colon).trim()
    var rest = raw.substring(colon + 1, raw.length)
    var parts = rest.split(",")
    var first = parts[0].trim()
    if (!strings.isNumeric(first)) {
        throw "personalidade: " + where + ": estado '" + name + "' com nivel invalido '" + first + "' (use 0 a 5)"
    }
    var level = toIntStr(first)
    if (level < 0 || level > 5) {
        throw "personalidade: " + where + ": estado '" + name + "' com nivel " + level + " fora da escala 0-5"
    }
    var triggers = listOf<String>()
    var i = 1
    while (i < parts.length) {
        var t = parts[i].trim()
        if (t != "") {
            triggers.add(t)
        }
        i = i + 1
    }
    return EmotionState(name, level, triggers)
}

// "compiladores: 2, angulo proprio" -> Domain.
Domain parseDomain(String raw, String where) {
    var colon = raw.indexOf(":")
    if (colon <= 0) {
        throw "personalidade: " + where + ": dominio '" + raw + "' sem nivel (formato 'nome: nivel, angulo')"
    }
    var name = raw.substring(0, colon).trim()
    var rest = raw.substring(colon + 1, raw.length)
    var parts = rest.split(",")
    var first = parts[0].trim()
    if (!strings.isNumeric(first)) {
        throw "personalidade: " + where + ": dominio '" + name + "' com nivel invalido '" + first + "'"
    }
    var level = toIntStr(first)
    if (level < 0 || level > 5) {
        throw "personalidade: " + where + ": dominio '" + name + "' com nivel " + level + " fora da escala 0-5"
    }
    var angle = ""
    var i = 1
    while (i < parts.length) {
        if (angle != "") {
            angle = angle + ","
        }
        angle = angle + parts[i]
        i = i + 1
    }
    return Domain(name, level, angle.trim())
}

// "0 neutro: texto tecnico..." -> ToneLevel. A ladder without level `n` for
// every n in 0..5 is a configuration error: the generator cannot pick an
// intensity the profile never defined.
ToneLevel parseToneLevel(String raw, String where) {
    var colon = raw.indexOf(":")
    if (colon <= 0) {
        throw "personalidade: " + where + ": nivel '" + raw + "' sem direcao (formato '0 neutro: o que muda no texto')"
    }
    var head = raw.substring(0, colon).trim()
    var sp = head.indexOf(" ")
    var num = head
    var nm = ""
    if (sp > 0) {
        num = head.substring(0, sp).trim()
        nm = head.substring(sp + 1, head.length).trim()
    }
    if (!strings.isNumeric(num)) {
        throw "personalidade: " + where + ": nivel '" + head + "' nao comeca com um numero 0-5"
    }
    var level = toIntStr(num)
    if (level < 0 || level > 5) {
        throw "personalidade: " + where + ": nivel " + level + " fora da escala 0-5"
    }
    return ToneLevel(level, nm, raw.substring(colon + 1, raw.length).trim())
}

String toneDirectionOf(List<ToneLevel> levels, Int n) {
    for (var l in levels) {
        if (l.level() == n) {
            return l.direction()
        }
    }
    return ""
}

String toneNameOf(List<ToneLevel> levels, Int n) {
    for (var l in levels) {
        if (l.level() == n) {
            return l.name()
        }
    }
    return ""
}

// Split "dominio: ..." out of the domain list is NOT done here: the domain
// level is part of each item, so the item is parsed as a whole.
List<Domain> parseDomains(List<String> raw, String where) {
    var out = listOf<Domain>()
    for (var r in raw) {
        out.add(parseDomain(r, where))
    }
    return out
}

List<EmotionState> parseStates(List<String> raw, String where) {
    var out = listOf<EmotionState>()
    for (var r in raw) {
        out.add(parseState(r, where))
    }
    return out
}

// Build the personality block. `authored` = the profile declares
// `# personality`: that is the switch that turns the requirements on. A profile
// without it is the pre-2026-11 layout and gets the documented fallbacks,
// recorded in `origin`, never a silent empty value.
Profile loadProfile(List<Section> secs, String path) {
    var authored = sectionDeclared(secs, "personality")
    var origin = listOf<String>()
    var background = sectionList(secs, "background", "background")
    var values = sectionList(secs, "values", "values")
    var personality = sectionList(secs, "personality", "personality")

    var lang = "voice"
    var voiceLanguage = sectionField(secs, lang, "language")
    var voiceTone = sectionField(secs, lang, "tone")

    var levels = listOf<ToneLevel>()
    var states = listOf<EmotionState>()
    var emotionRules = sectionList(secs, "emotional-profile", "rules")
    var domains = parseDomains(sectionList(secs, "technical-domains", "technical_domains"), "technical-domains")
    var strong = sectionList(secs, "strong-language", "strong_language")
    var strongLevels = 4
    var rawLvl = sectionField(secs, "strong-language", "levels")
    if (rawLvl != "") {
        if (!strings.isNumeric(rawLvl)) {
            throw "personalidade: strong_language.levels deve ser um inteiro (recebido '" + rawLvl + "')"
        }
        strongLevels = toIntStr(rawLvl)
        if (strongLevels < 0 || strongLevels > 5) {
            throw "personalidade: strong_language.levels fora da escala 0-5: " + strongLevels
        }
    }
    if (authored) {
        var rawLevels = sectionList(secs, "emotional-profile", "levels")
        if (rawLevels.size() == 0) {
            throw "personalidade: # personality declarada, mas emotional_profile.levels esta vazio — defina os seis niveis (0-5)"
        }
        for (var r in rawLevels) {
            levels.add(parseToneLevel(r, "emotional_profile.levels"))
        }
        var i = 0
        while (i <= 5) {
            var hit = false
            for (var l in levels) {
                if (l.level() == i) {
                    hit = true
                }
            }
            if (!hit) {
                throw "personalidade: emotional_profile.levels sem o nivel " + i + " (a escala precisa dos seis, 0 a 5)"
            }
            i = i + 1
        }
        states = parseStates(sectionList(secs, "emotional-profile", "states"), "emotional_profile.states")
        if (states.size() == 0) {
            throw "personalidade: # personality declarada, mas emotional_profile.states esta vazio"
        }
        if (domains.size() == 0) {
            throw "personalidade: # personality declarada, mas technical_domains esta vazio"
        }
        if (sectionList(secs, "editorial-engine", "questions").size() == 0) {
            throw "personalidade: # personality declarada, mas editorial_engine.questions esta vazio"
        }
        if (sectionList(secs, "diversity", "formats").size() == 0) {
            throw "personalidade: # personality declarada, mas diversity.formats esta vazio"
        }
        if (sectionList(secs, "review", "checks").size() == 0) {
            throw "personalidade: # personality declarada, mas review.checks esta vazio"
        }
        if (rawLvl == "") {
            throw "personalidade: # personality declarada, mas strong_language.levels esta ausente"
        }
    }

    // Formats fall back to the same list the profile always declared under
    // `# editorial` before formats existed: the old "category" labels were the
    // only format signal. Recorded in origin.
    var formats = sectionList(secs, "diversity", "formats")
    if (formats.size() > 0) {
        origin.add("diversity.formats=profile")
    } else {
        origin.add("diversity.formats=fallback:sem formato declarado (post fica sem marcador e a validacao usa apresentacao natural)")
    }
    var emotionOrigin = "profile"
    if (levels.size() == 0 || states.size() == 0) {
        emotionOrigin = "fallback:sem # personality (intensidade derivada do dominio e da funcao do horario)"
    }
    origin.add("emotional_profile=" + emotionOrigin)
    origin.add("technical_domains=" + sectionOrigin(secs, "technical-domains", "technical_domains"))

    var memory = listOr(secs, "memory", "memory", secs, "editorial", "diversity")
    var checks = sectionList(secs, "review", "checks")
    if (checks.size() == 0) {
        origin.add("review.checks=fallback:checks fixos do codigo (autenticidade, profundidade, linguagem, diversidade, honestidade)")
    } else {
        origin.add("review.checks=profile")
    }
    var restrictions = sectionList(secs, "restrictions", "restrictions")
    if (sectionList(secs, "factuality", "authenticity").size() > 0) {
        origin.add("factuality.authenticity=profile")
    } else if (sectionList(secs, "editorial", "authenticity").size() > 0) {
        origin.add("factuality.authenticity=fallback:editorial.authenticity")
    } else {
        origin.add("factuality.authenticity=fallback:regras fixas do codigo")
    }
    origin.add("background=" + sectionOrigin(secs, "background", "background"))
    origin.add("values=" + sectionOrigin(secs, "values", "values"))
    origin.add("personality=" + sectionOrigin(secs, "personality", "personality"))
    origin.add("memory=" + firstNonEmpty(sectionOrigin(secs, "memory", "memory"), "ausente"))
    origin.add("signature.motifs=" + sectionOrigin(secs, "signature", "motifs"))
    origin.add("platforms=" + sectionOrigin(secs, "platforms", "linkedin"))

    return Profile(
        authored,
        background,
        values,
        personality,
        path,
        voiceLanguage,
        voiceTone,
        sectionField(secs, "technical-domains", "description"),
        levels,
        states,
        emotionRules,
        domains,
        sectionList(secs, "industry-positions", "industry_positions"),
        sectionList(secs, "teaching-positions", "teaching_positions"),
        sectionList(secs, "projects", "projects"),
        sectionList(secs, "editorial-engine", "questions"),
        sectionList(secs, "editorial-engine", "avoid_forms"),
        formats,
        memory,
        sectionList(secs, "memory", "signature_phrases"),
        sectionList(secs, "language", "expressions"),
        sectionList(secs, "language", "rhythm"),
        sectionList(secs, "language", "cliche_structures"),
        sectionList(secs, "language", "not_like"),
        strong,
        strongLevels,
        checks,
        sectionList(secs, "review", "neutralize_forbidden"),
        restrictions,
        sectionList(secs, "signature", "motifs"),
        sectionField(secs, "platforms", "linkedin"),
        sectionField(secs, "platforms", "enois"),
        sectionField(secs, "platforms", "outras"),
        origin)
}

String sectionOrigin(List<Section> secs, String name, String key) {
    if (sectionDeclared(secs, name)) {
        return "profile"
    }
    return "ausente"
}

// Parse a company .md (KofMD) file into the editorial model. Honest String
// errors on anything structural — no silent defaults for identity fields.
Company loadCompany(String path) {
    var f = File(path)
    var raw = f.readText()
    if (raw == null) {
        throw "company file not readable: " + path
    }
    var tool = KofmdTool()
    var doc = tool.parse(raw)
    var schemas = tool.parseSchemas(raw)
    var companySchema = findSchema(schemas, "Company")
    if (companySchema != null) {
        var diags = tool.validateDoc(doc, companySchema)
        if (diags.size() > 0) {
            throw "company.kofmd schema: " + diags.get(0)
        }
    }
    var secs = CompanySections(doc).all()
    var name = globalField(secs, "name")
    if (name == "") {
        throw "company.kofmd: field 'name' is required (section # company)"
    }
    var mode = firstNonEmpty(sectionField(secs, "publishing", "mode"), globalField(secs, "mode"))
    if (mode != "" && mode != "assisted" && mode != "autonomous") {
        throw "company.kofmd: publishing mode '" + mode + "' invalid (use assisted|autonomous)"
    }
    // Timezone must be explicit — the Publisher never assumes UTC silently.
    var tz = firstNonEmpty(sectionField(secs, "publishing", "timezone"), globalField(secs, "timezone"))
    if (tz == "") {
        throw "company.kofmd: publishing.timezone is required (explicit IANA zone, e.g. America/Sao_Paulo)"
    }
    if (!isValidZone(tz)) {
        throw "company.kofmd: invalid timezone '" + tz + "' (use e.g. America/Sao_Paulo)"
    }
    if (!validOffset(zoneOffsetHours(tz, time.now()))) {
        throw "company.kofmd: timezone '" + tz + "' unavailable on this runtime — refusing to assume UTC"
    }
    var target0 = firstNonEmpty(sectionField(secs, "publishing", "target"), globalField(secs, "target"))
    // Editorial policy (# editorial): size limit, material gate, diversity
    // strategy and authenticity rules — explicit, easy to maintain, no
    // separate framework.
    var maxChars = 0
    var rawMax = sectionField(secs, "editorial", "max_chars")
    if (rawMax != "" && strings.isNumeric(rawMax)) {
        maxChars = toIntStr(rawMax)
    }
    var requireMaterial = sectionField(secs, "editorial", "require_material") == "true"
    // Research policy: which sources to consult before choosing topics, and how
    // old a story may be and still pass as current. `0` (or absent) means no
    // explicit window — the age is still RECORDED and reported, never assumed.
    var researchSources = sectionList(secs, "editorial", "research")
    var researchMaxAgeHours = 0
    var rawAge = sectionField(secs, "editorial", "research_max_age_hours")
    if (rawAge != "" && strings.isNumeric(rawAge)) {
        researchMaxAgeHours = toIntStr(rawAge)
    }
    // Retention: a record count (how many editorial records to keep) and a
    // storage ceiling in GB (the safety valve, not a target).
    var retentionRecords = 10000
    var rawRet = sectionField(secs, "editorial", "retention_records")
    if (rawRet != "" && strings.isNumeric(rawRet)) {
        retentionRecords = toIntStr(rawRet)
    }
    var retentionMaxGb = 20
    var rawGb = sectionField(secs, "editorial", "retention_max_gb")
    if (rawGb != "" && strings.isNumeric(rawGb)) {
        retentionMaxGb = toIntStr(rawGb)
    }
    return Company(
        path,
        name,
        globalField(secs, "description"),
        globalField(secs, "audience_primary"),
        globalField(secs, "audience_secondary"),
        globalField(secs, "positioning"),
        globalField(secs, "language"),
        globalField(secs, "tone"),
        mode,
        tz,
        target0,
        globalList(secs, "products"),
        globalList(secs, "topics"),
        globalList(secs, "avoid"),
        globalList(secs, "goals"),
        schedulesOf(secs, tz, mode),
        expandVars(firstNonEmpty(sectionField(secs, "publishing", "source_repo"), globalField(secs, "source_repo"))),
        firstNonEmpty(sectionField(secs, "publishing", "source_ref"), globalField(secs, "source_ref")),
        globalList(secs, "guide"),
        digestText(raw),
        globalList(secs, "opinions"),
        globalList(secs, "facts"),
        categoriesOf(secs),
        sectionList(secs, "editorial", "diversity"),
        sectionList(secs, "editorial", "authenticity"),
        maxChars,
        requireMaterial,
        globalList(secs, "principles"),
        globalList(secs, "sources"),
        githubConfigOf(secs),
        researchSources,
        researchMaxAgeHours,
        retentionRecords,
        retentionMaxGb,
        globalList(secs, "thinking"),
        globalList(secs, "argumentation"),
        globalList(secs, "rejects"),
        globalList(secs, "evidence"),
        sectionList(secs, "editorial", "research_feeds"),
        sectionList(secs, "editorial", "subjects"),
        loadProfile(secs, path))
}

KofmdSchema? findSchema(List<KofmdSchema> schemas, String name) {
    for (var s in schemas) {
        if (s.name() == name) {
            return s
        }
    }
    return null
}
