

// Scheduler — the recurring editorial agent (acceptance §7, §8, §12, §13, §22).
//
// KofTime defines WHEN (next occurrences computed with the calendar
// primitives; waiting is time.sleep bounded by the computed instant); the
// Publisher defines WHAT (generate -> validate -> review|publish -> record).
// The daemon loop:
//
//   recover persisted schedules -> recompute nextExecution via KofTime
//   -> sleep until the nearest occurrence -> for each due schedule:
//      claim the occurrence (idempotent ledger insert)
//      -> generate via KofLM -> validate -> revise -> review|publish
//      -> record result -> recompute next occurrence -> loop
//
// No cron parser, no in-memory-only timers, no aggressive polling: the
// agenda lives in the store, so a restarted daemon resumes it unchanged
// (§7). A claimed occurrence is never re-run even if the process died
// mid-way (§12 duplicate/race/restart). Retry happens INSIDE one execution
// against the SAME stored draft — a failed publish never regenerates a
// different post (§13).

record ExecReport(String occurrenceId, String publicationId, String result, String detail)

String publisherStopFile() {
    return defaultPublisherHome() + "/STOP"
}

Bool publisherStopRequested() {
    return File(publisherStopFile()).exists()
}

class Scheduler {
    Store store
    Company company
    Int maxAttempts
    Int attemptDelayMs
    // Same-day retry of a SLOT that did not manage to post. A missed post is
    // not the same as a publish retry (maxAttempts): here the whole occurrence
    // is re-run later — fresh research, fresh selection — because the cause may
    // be "no candidate right now" or a draft the factual gate refused, and the
    // material changes over the day. Bounded by `retryMax` attempts and by the
    // next slot, so a slot never overlaps the following one and the loop cannot
    // spin forever. Never fabricates: a retry that finds nothing honest still
    // skips.
    Int retryMax
    Int retryDelayMin
    // PREPARE-AHEAD: quanto antes do horario o texto e GERADO. A publicacao
    // continua acontecendo na hora exata — o que muda e quando o rascunho e
    // produzido. Sem isto, gerar no proprio horario significa que qualquer
    // atraso de rede ou rejeicao do gate faz o post perder o horario; gerando
    // antes, o texto ja esta validado e esperando quando o relogio chega.
    Int prepLeadMin
    // MIRROR (enois): instead of waiting for a clock slot, the daemon looks at
    // the author's enois profile every `publisher.enois.poll.min` minutes and
    // shares whatever is new. 0 disables the poll entirely, which is the
    // default: the active mode is the clock schedule (the mirror stays in the
    // code, tested, ready to be switched back on from the environment).
    Int enoisPollMin
    Long lastEnoisPoll

    constructor(Store store, Company company) {
        this.store = store
        this.company = company
        maxAttempts = config.int("publisher.attempts", 3)
        attemptDelayMs = config.int("publisher.attempt.delay.ms", 2000)
        retryMax = config.int("publisher.retry.max", 3)
        retryDelayMin = config.int("publisher.retry.delay.min", 20)
        prepLeadMin = config.int("publisher.prep.lead.min", 10)
        enoisPollMin = config.int("publisher.enois.poll.min", 0)
        lastEnoisPoll = 0L
    }

    // One enois cycle, logged honestly: how many posts were read, how many were
    // new, what was shared. Runs at startup too (lastEnoisPoll starts at 0), so
    // a daemon that was down still catches up on the first loop.
    Int pollEnoisOnce() {
        lastEnoisPoll = time.now()
        var rep = mirrorPoll(store, company, false)
        if (rep.baseline()) {
            log.info("enois: linha de base — " + rep.fresh() + " post(s) existente(s) marcado(s) como visto(s), nada publicado")
            return 0
        }
        log.info("enois: " + rep.listed() + " post(s) lido(s), " + rep.fresh() + " novo(s), " + rep.shared() + " compartilhado(s), " + rep.skipped() + " ignorado(s), " + rep.failed() + " falha(s)")
        for (var l in rep.lines()) {
            log.info("enois: " + l)
        }
        return 0
    }

    // Is the pending occurrence the slot's CLOCK occurrence (as opposed to a
    // same-day retry)? Only the clock occurrence is pulled forward by the prep
    // lead; a retry runs at the instant it was scheduled.
    Bool isClockRun(Schedule s) {
        var nx = s.next_execution()
        var clk = s.clock()
        if (nx == "" || clk == "" || nx.length < 16) {
            return false
        }
        return nx.substring(11, 16) == clk
    }

    Long prepLeadMs() {
        return (prepLeadMin as Long) * 60000L
    }

    // Publica as publicacoes AGENDADAS cujo horario chegou. Roda em todo ciclo
    // do daemon, independente do agendamento: e o que faz o post sair na hora
    // exata mesmo tendo sido gerado dez minutos antes.
    Int publishDueScheduled() {
        for (var p in store.publicationsByStatus(statusScheduled())) {
            if (p.scheduled_at() == "") {
                continue
            }
            if (millisUntil(p.scheduled_at()) > 0) {
                continue
            }
            var rep = publishWithRetry(p.occurrence_key(), p.recurrence_id(), p.scheduled_at(), p.id(), p.topic(), p.content(), nowStamp(), p.target())
            if (rep.result() == "published" && company.sourceRepo() != "") {
                advanceLabMarker(p.scheduled_at())
            }
            log.info("agendado " + p.id() + " (" + p.scheduled_at() + ") -> " + rep.result())
        }
        return 0
    }

    // When a slot fails to post, when should it try again? `now + retryDelayMin`
    // — but only if that still fits BEFORE the next slot; otherwise the retry is
    // dropped and the normal schedule takes over (the next slot will run anyway).
    // Returns "" when no retry fits.
    String retryInstant(Schedule s, String occIso) {
        var nextSlot = computeNext(s, occIso)
        var delayMin = retryDelayMin
        // While the occurrence is STILL AHEAD we are inside the prep window: the
        // failure was "could not prepare in time", and the answer is to try
        // again SOON (a few minutes), not in 20 — otherwise the retry would land
        // after the hour and the post would go out late, which is the opposite
        // of the point of preparing ahead.
        if (millisUntil(occIso) > 0) {
            delayMin = config.int("publisher.prep.retry.min", 3)
        }
        if (delayMin <= 0) {
            return ""
        }
        var sp = localOf(s.timezone(), time.now() + ((delayMin as Long) * 60000L))
        if (sp == null) {
            return ""
        }
        var retryAt = isoOf(sp)
        // The retry must still fit before the occurrence (prep window) or before
        // the next slot (after the hour).
        var limit = nextSlot
        if (millisUntil(occIso) > 0) {
            limit = occIso
        }
        if (limit != "" && millisUntil(retryAt) >= millisUntil(limit)) {
            return ""
        }
        return retryAt
    }

    // A slot only retries while it still has budget for the day.
    Bool retryBudgetLeft(Schedule s, String occIso) {
        if (retryMax <= 0 || occIso.length < 10) {
            return false
        }
        return store.occurrencesForDay(s.name(), occIso.substring(0, 10)) <= retryMax
    }

    // Effective mode: schedule override > company mode > SAFE DEFAULT
    // "assisted" — autonomous is explicitly opt-in (§9).
    String effectiveMode(Schedule s) {
        if (s.mode() != "") {
            return s.mode()
        }
        if (company.mode() != "") {
            return company.mode()
        }
        return "assisted"
    }

    String nowStamp() {
        var sp = localOf(company.timezone(), time.now())
        if (sp == null) {
            throw "company timezone '" + company.timezone() + "' unavailable on this runtime"
        }
        return isoOf(sp)
    }

    // ---- agenda persistence ----

    Schedule register(Schedule s) {
        var existing = store.findSchedule(s.name())
        var created = nowStamp()
        var next = ""
        if (existing != null) {
            created = existing.created_at()
            // Re-registering (`sync`) used to compute the next occurrence from
            // created_at — the FIRST slot after the schedule was born. Days
            // later that instant is in the past, and the running loop treats a
            // past `next` as DUE, firing every restored clock at once. A still
            // valid next is kept only when the definition did not change (so a
            // same-day retry survives a sync); otherwise recompute from NOW.
            var prev = existing.next_execution()
            var sameShape = existing.clock() == s.clock() && existing.days() == s.days() && existing.interval_days() == s.interval_days() && existing.anchor_date() == s.anchor_date()
            if (prev != "" && millisUntil(prev) > 0 && sameShape) {
                next = prev
            }
        }
        if (next == "") {
            next = computeNext(s, nowStamp())
        }
        if (next == "") {
            throw "schedule '" + s.name() + "': cannot compute next occurrence — timezone '" + s.timezone() + "' unavailable or days/at invalid"
        }
        var saved = Schedule(s.name(), s.days(), s.interval_days(), s.anchor_date(), s.clock(), s.timezone(), s.topic(), s.mode(), s.target(), "active", next, "", created, nowStamp())
        store.saveSchedule(saved)
        observability.increment("publisher.schedule.created", 1)
        log.info("agenda '" + saved.name() + "' registrada: proxima ocorrencia " + next)
        return saved
    }

    // Restart recovery: reload persisted schedules, recompute the next
    // execution through KofTime. The agenda survives the process (§7).
    List<Schedule> recoverAgenda() {
        var out = listOf<Schedule>()
        for (var s in store.activeSchedules()) {
            // Restart must NOT drop an occurrence whose instant passed while
            // the daemon was down (acceptance: restart). A stored next that is
            // in the future, or overdue by at most 10 minutes, is kept so the
            // main loop runs it NOW; only empty/invalid/stale instants are
            // recomputed forward.
            var next = s.next_execution()
            if (next != "") {
                if (0 - millisUntil(next) > 600000) {
                    next = ""
                }
            }
            if (next == "") {
                next = computeNext(s, nowStamp())
            }
            if (next == "") {
                log.error("agenda '" + s.name() + "': timezone '" + s.timezone() + "' indisponivel — recusa (nunca assume UTC)")
            } else {
                var fixed = Schedule(s.name(), s.days(), s.interval_days(), s.anchor_date(), s.clock(), s.timezone(), s.topic(), s.mode(), s.target(), s.status(), next, s.last_execution(), s.created_at(), nowStamp())
                store.saveSchedule(fixed)
                out.add(fixed)
                log.info("agenda '" + s.name() + "' recuperada: proxima ocorrencia " + next)
            }
        }
        return out
    }

    Bool cancelSchedule(String name) {
        var found = store.findSchedule(name)
        if (found == null) {
            return false
        }
        var s = found
        store.saveSchedule(Schedule(name, s.days(), s.interval_days(), s.anchor_date(), s.clock(), s.timezone(), s.topic(), s.mode(), s.target(), "cancelled", "", s.last_execution(), s.created_at(), nowStamp()))
        return true
    }

    // ---- next occurrence (the KofTime consumer) ----

    String computeNext(Schedule s, String fromIso) {
        var from = spanFromIso(fromIso)
        if (from == null) {
            from = localOf(s.timezone(), time.now())
        }
        if (from == null) {
            return ""
        }
        var clock = parseClock(s.clock())
        if (clock < 0) {
            return ""
        }
        var hour = clock / 60
        var minute = clock % 60
        if (s.interval_days() > 0) {
            var anchor = s.anchor_date()
            if (anchor == "") {
                anchor = from.date()
            }
            var r = nextIntervalDue(from, anchor, s.interval_days(), hour, minute, s.timezone())
            if (r != null) {
                return isoOf(r)
            }
            return ""
        }
        var rules = listOf<Weekly>()
        for (var d in daysList(s)) {
            var wd = weekdayFromName(d)
            if (wd < 0) {
                return ""
            }
            rules.add(Weekly(wd, hour, minute))
        }
        if (rules.size() == 0) {
            return ""
        }
        var best = nextDue(from, rules, s.timezone())
        if (best != null) {
            return isoOf(best)
        }
        return ""
    }

    // Millis until an occurrence ISO stamp (the stored EXPLICIT offset is
    // honored — never assumes UTC).
    Long millisUntil(String occIso) {
        var sp = spanFromIso(occIso)
        if (sp == null) {
            return 0
        }
        return localToUtc(sp) - time.now()
    }

    // ---- one occurrence: the full pipeline ----

    ExecReport runOccurrence(Schedule s, String occIso) {
        var key = occurrenceKeyOf(s.name(), occIso)
        var started = nowStamp()
        if (!store.claimOccurrence(key, s.name(), occIso, started)) {
            log.info("ocorrencia " + key + " ja reivindicada — ignorando (idempotente: duplicate/restart/race)")
            return ExecReport(key, "", "skipped", "already claimed")
        }
        observability.increment("publisher.schedule.triggered", 1)
        var recent = store.recentEditorialContents(8, "")
        var mode = effectiveMode(s)
        var target = targetName(s)
        // The schedule's clock maps to an editorial category (personal profile
        // 06/12/15/18). No category declared -> the generic path, exactly the
        // previous behaviour (KofLab is unaffected).
        var catLabel = ""
        var catAngle = ""
        var cat = categoryAt(company.categories(), s.clock())
        if (cat != null) {
            var c2 = cat
            catLabel = c2.label()
            catAngle = c2.angle()
        }
        var topic = ""
        var objective = ""
        var ed = Editorial(company)
        var isProfileSlot = cat != null
        var chosen = PlanChoice("", "", "", "", "", false, emptyCandidate(), "")
        var run = ResearchRun(listOf<ResearchItem>(), listOf<String>(), 0)
        if (isProfileSlot) {
            // EDITORIAL PROFILE — the SAME pipeline `plan` runs, executed at
            // every clock. Without this the daemon would generate from the
            // static profile alone: the news slot would never see a current
            // source, and the pauta behind the draft would never be recorded,
            // so a later cycle could not tell the topic had already been used.
            //
            // Research is best-effort and honest: a source that fails is logged
            // and the slot is SKIPPED, never filled with an invented story.
            var runR = researchRun(company.timezone(), company.researchSources(), researchFeedUrls(company), "")
            run = runR
            for (var rn in run.notes()) {
                log.info("pesquisa " + s.clock() + ": " + rn)
            }
            // Same history the `plan` command feeds the scorer: the persisted
            // pautas AND the topics of the drafts already written. Using only
            // one of the two would make the daemon slightly more willing to
            // repeat than the manual command.
            var history = store.recentTopicThemes(12)
            for (var ht in store.recentTopics(12)) {
                history.add(ht)
            }
            var plan = buildPlan(company, store, run, 0, history, subjectWindow())
            var found = false
            for (var pc in plan.choices()) {
                if (pc.clock() == s.clock()) {
                    chosen = pc
                    found = true
                }
            }
            if (!found) {
                var whyNoSlot = "nenhuma pauta para o horario " + s.clock() + " no plano"
                store.updateOccurrence(Occurrence(key, s.name(), occIso, "", "planning", "skipped", whyNoSlot, started, nowStamp()))
                observability.increment("publisher.content.skipped", 1)
                log.info("ocorrencia " + key + ": " + whyNoSlot)
                return ExecReport(key, "", "skipped", whyNoSlot)
            }
            if (!chosen.chosen()) {
                var whySkip = chosen.skip_reason()
                store.updateOccurrence(Occurrence(key, s.name(), occIso, "", "planning", "skipped", whySkip, started, nowStamp()))
                observability.increment("publisher.content.skipped", 1)
                log.info("ocorrencia " + key + ": SKIP — " + whySkip)
                return ExecReport(key, "", "skipped", whySkip)
            }
            var cand = chosen.candidate()
            topic = cand.theme()
            objective = planObjective(chosen)
            var block = planEvidenceBlock(store, chosen, run)
            if (block != "") {
                ed = ed.withExtra(block)
            }
        } else {
            topic = pickTopic(s, recent)
            objective = "conteudo recorrente da agenda '" + s.name() + "'"
            if (company.github().enabled()) {
                var gh = githubDigest(store, company, 4)
                if (gh != "") {
                    ed = ed.withExtra(gh)
                }
            }
        }
        var pubId = "pub-" + strings.slugify(key)
        var existingPub = store.byOccurrenceKey(key)
        var content = ""
        if (existingPub != null) {
            // retry of a recorded draft — the publication keeps its identity
            content = existingPub.content()
            pubId = existingPub.id()
        } else {
            var v = Validation(false, listOf<String>("nothing generated"), listOf<String>())
            var round = 0
            while (round < 3) {
                var draft = ""
                try {
                    draft = ed.generateIn(topic, recent, objective, catLabel, catAngle)
                } catch (String e) {
                    // LAB-SKIP = no lab news in the window; SKIP = no material
                    // at all. Both mean "nothing honest to publish now" — the
                    // occurrence is skipped, never fabricated, and the window
                    // does NOT advance so the next run can cover it.
                    //
                    // Qualquer outra String e uma falha de geracao honesta (o
                    // LM respondeu erro, o draft veio vazio). Ela NAO pode ser
                    // re-lancada daqui: um `throw` dentro do catch escapa do
                    // try inteiro — o `catch (Throwable)` ao lado nunca ve — e
                    // a ocorrencia ficava presa em `claimed`, sem registro e
                    // sem retentativa. Medido em 2026-11-02. Resolvida e
                    // registrada da mesma forma.
                    var msg = e
                    if (msg.startsWith("LAB-SKIP") || msg.startsWith("SKIP")) {
                        log.info("ocorrencia " + key + ": " + msg + " (janela NAO avanca — amanha tenta de novo)")
                    } else {
                        log.warn("ocorrencia " + key + ": geracao falhou: " + msg)
                    }
                    store.updateOccurrence(Occurrence(key, s.name(), occIso, "", "generation", "skipped", msg, started, nowStamp()))
                    observability.increment("publisher.content.skipped", 1)
                    return ExecReport(key, "", "skipped", msg)
                } catch (Throwable e) {
                    // Um timeout do LM chega aqui como excecao NAO-String (no
                    // log ela aparece enrolada num "... unexpected JSON char
                    // ..."). Sem este catch ela escapava do laco do daemon e o
                    // main imprimia "publisher: error" e ENCERRAVA o processo:
                    // medido 2026-11-02, o daemon morreu as 11:54 na
                    // retentativa do meio-dia e os posts das 15:00 e 18:00
                    // nunca sairam. A ocorrencia e registrada e o daemon
                    // continua vivo (ou se sai por STOP), devolvendo a
                    // decisao a retentativa do dia.
                    var em = e.toString()
                    store.updateOccurrence(Occurrence(key, s.name(), occIso, "", "generation", "skipped", em, started, nowStamp()))
                    observability.increment("publisher.content.skipped", 1)
                    log.warn("ocorrencia " + key + ": geracao falhou (erro interno): " + em)
                    return ExecReport(key, "", "skipped", "generation: " + em)
                }
                v = ed.validate(draft, recent)
                if (v.ok()) {
                    content = draft
                    break
                }
                draft = ed.reviseIn(draft, v, recent, catLabel, catAngle)
                var v2 = ed.validate(draft, recent)
                if (v2.ok()) {
                    content = draft
                    v = v2
                    break
                }
                v = v2
                round = round + 1
            }
            if (content == "") {
                store.updateOccurrence(Occurrence(key, s.name(), occIso, "", "validation", "failed", joinList(v.problems()), started, nowStamp()))
                observability.increment("publisher.content.rejected", 1)
                log.error("ocorrencia " + key + ": validacao falhou — descartada: " + joinList(v.problems()))
                return ExecReport(key, "", "failed", "validation: " + joinList(v.problems()))
            }
            observability.increment("publisher.content.generated", 1)
            observability.increment("publisher.content.validated", 1)
            // The pauta behind the draft is recorded BEFORE the draft itself,
            // exactly as `plan` does: the next cycle then sees the topic as
            // already used, and the draft can point at the sources that
            // grounded it.
            var topicId = ""
            if (isProfileSlot) {
                topicId = persistPlanTopic(store, company, chosen, pubId, run, nowStamp())
                var srcs = store.sourcesByTopic(topicId)
                var cnd = chosen.candidate()
                var fc = ed.validateFactual(content, srcs, cnd.origin(), cnd.published_at(), cnd.evidence())
                if (!fc.ok()) {
                    // Editorial quality passed but the mechanical factual proxy
                    // did not. The draft is KEPT in REVIEW carrying the caveat
                    // — never approved, never published — so the problem is
                    // visible instead of silently swallowed.
                    store.savePublication(Publication(pubId, company.name(), topic, content, statusReview(), nowStamp(), occIso, "", target, lmModel(), company.digest(), s.name(), "", "", key, 0, topicId))
                    markTopicOutcome(store, topicId, "review-com-ressalva", joinList(fc.problems()))
                    observability.increment("publisher.content.rejected", 1)
                    log.warn("ocorrencia " + key + ": rascunho em REVIEW com ressalva factual: " + joinList(fc.problems()))
                    store.updateOccurrence(Occurrence(key, s.name(), occIso, pubId, "review", "awaiting", "", started, ""))
                    return ExecReport(key, pubId, "review", "factual: " + joinList(fc.problems()))
                }
                markTopicOutcome(store, topicId, "validado", "")
            }
            store.updateOccurrence(Occurrence(key, s.name(), occIso, pubId, "generation", "success", "", started, ""))
            var status = statusApproved()
            if (mode == "assisted") {
                status = statusReview()
            }
            // PREPARE-AHEAD: em autonomo, um rascunho gerado ANTES do horario
            // fica AGENDADO para a hora exata em vez de ser publicado agora.
            if (mode == "autonomous" && millisUntil(occIso) > 0) {
                status = statusScheduled()
            }
            store.savePublication(Publication(pubId, company.name(), topic, content, status, nowStamp(), occIso, "", target, lmModel(), company.digest(), s.name(), "", "", key, 0, topicId))
        }
        if (mode == "assisted") {
            store.updateOccurrence(Occurrence(key, s.name(), occIso, pubId, "review", "awaiting", "", started, ""))
            log.info("ocorrencia " + key + ": rascunho " + pubId + " em REVIEW aguardando aprovacao humana (assisted)")
            return ExecReport(key, pubId, "review", "awaiting approval")
        }
        if (millisUntil(occIso) > 0) {
            // gerado com antecedencia: quem publica e o passe de agendados, na hora
            store.updateOccurrence(Occurrence(key, s.name(), occIso, pubId, "prepared", "ready", "", started, ""))
            log.info("ocorrencia " + key + ": texto pronto, sera publicado em " + occIso)
            return ExecReport(key, pubId, "prepared", "aguardando o horario " + occIso)
        }
        var rep = publishWithRetry(key, s.name(), occIso, pubId, topic, content, started, target)
        if (rep.result() == "published" && company.sourceRepo() != "") {
            advanceLabMarker(occIso)
        }
        return rep
    }

    // Controlled retry: attempt -> backoff -> attempt -> ... -> FAILED.
    // Regenerating on a publish failure is FORBIDDEN (§13): the same draft
    // is re-published; the occurrence keeps its identity.
    ExecReport publishWithRetry(String key, String schedName, String occIso, String pubId, String topic, String content, String started, String targetName) {
        var pub = store.findPublication(pubId)
        var createdAt = started
        var company1 = company.name()
        var ctx = company.digest()
        // The link to the PAUTA must survive the publish lifecycle. These
        // savePublication calls rewrite the whole row, and they used to pass ""
        // for topic_id — so every PUBLISHED post lost its provenance, and
        // `review` could no longer show the sources behind it (measured
        // 2026-10-13: the 12:00 post was published with topic_id empty while its
        // pauta existed). Carry the existing value forward.
        var topicIdKeep = ""
        if (pub != null) {
            createdAt = pub.created_at()
            company1 = pub.company()
            ctx = pub.context_version()
            topicIdKeep = pub.topic_id()
        }
        var target = resolveTarget(targetName)
        if (target == null) {
            var msg = targetErrorPrefix(targetName) + " desconhecido"
            store.updateOccurrence(Occurrence(key, schedName, occIso, pubId, "publication", "failed", msg, started, nowStamp()))
            log.error("ocorrencia " + key + ": " + msg)
            return ExecReport(key, pubId, "failed", msg)
        }
        var attempt = 1
        var delay = attemptDelayMs
        var lastError = ""
        while (attempt <= maxAttempts) {
            store.savePublication(Publication(pubId, company1, topic, content, statusPublishing(), createdAt, occIso, "", targetName, lmModel(), ctx, schedName, "", "", key, attempt, topicIdKeep))
            observability.increment("publisher.publication.started", 1)
            try {
                var out = target.publish(content)
                store.savePublication(Publication(pubId, company1, topic, content, statusPublished(), createdAt, occIso, nowStamp(), targetName, lmModel(), ctx, schedName, out.externalId(), "", key, attempt, topicIdKeep))
                store.updateOccurrence(Occurrence(key, schedName, occIso, pubId, "publication", "success", out.externalId(), started, nowStamp()))
                observability.increment("publisher.publication.completed", 1)
                log.info("ocorrencia " + key + ": publicada -> " + out.externalId())
                return ExecReport(key, pubId, "published", out.externalId())
            } catch (String e) {
                lastError = e
                observability.increment("publisher.publication.failed", 1)
                log.warn("ocorrencia " + key + ": tentativa " + attempt + "/" + maxAttempts + " falhou: " + e)
                if (attempt < maxAttempts) {
                    time.sleep(delay)
                    delay = delay * 2
                }
            } catch (Throwable e) {
                // AUDIT FIX (AUD-9): only String failures were caught, so an
                // Error thrown inside a target (measured: a JVM VerifyError from
                // the 0.5.0-beta codegen on the LinkedIn publish path) escaped
                // this loop entirely and left the publication in `publishing` —
                // a state with NO exit: not publishable, not cancellable, not
                // retryable. Recording it as `failed` keeps the state machine
                // terminal and the content visible instead of stranded.
                lastError = e.toString()
                observability.increment("publisher.publication.failed", 1)
                log.warn("ocorrencia " + key + ": tentativa " + attempt + "/" + maxAttempts + " falhou (erro interno): " + lastError)
                if (attempt < maxAttempts) {
                    time.sleep(delay)
                    delay = delay * 2
                }
            }
            attempt = attempt + 1
        }
        store.savePublication(Publication(pubId, company1, topic, content, statusFailed(), createdAt, occIso, "", targetName, lmModel(), ctx, schedName, "", lastError, key, maxAttempts, topicIdKeep))
        store.updateOccurrence(Occurrence(key, schedName, occIso, pubId, "publication", "failed", lastError, started, nowStamp()))
        log.error("ocorrencia " + key + ": FAILED apos " + maxAttempts + " tentativas — " + lastError)
        return ExecReport(key, pubId, "failed", lastError)
    }

    // Topic selection (TopicDiscovery consumer): explicit schedule topic wins;
    // else company topics rotated against recent content; else KofLM discovery.
    String pickTopic(Schedule s, List<String> recent) {
        if (s.topic() != "") {
            return s.topic()
        }
        var topics = company.topics()
        if (topics.size() == 0) {
            var disc = Editorial(company).discoverTopics(5, store.recentTopics(20))
            if (disc.size() > 0) {
                return disc.get(0)
            }
            throw "sem topicos: company.kofmd nao declara topics e a descoberta via KofLM falhou"
        }
        var used = setOf<String>()
        for (var r in recent) {
            used.add(r)
        }
        for (var t in topics) {
            if (!used.contains(t)) {
                return t
            }
        }
        return topics.get(0)
    }

    String targetName(Schedule s) {
        if (s.target() == "") {
            return "linkedin"
        }
        return s.target()
    }

    // ---- daemon loop ----

    Int runForever() {
        // Fresh daemon identity: drop a leftover STOP (a previous stop must
        // not instantly end a new start) and record our own pid + heartbeat.
        File(publisherStopFile()).delete()
        daemonWritePid()
        recoverAgenda()
        while (true) {
            daemonHeartbeat()
            // Publica o que ja esta agendado e venceu (gerado com antecedencia).
            // Se este passe falhar, o laço continua: os horarios seguem rodando
            // e o rascunho continua `scheduled` para a proxima volta.
            try {
                publishDueScheduled()
            } catch (Throwable e) {
                log.error("daemon: passe de publicacoes agendadas falhou: " + e.toString())
            }
            // MIRROR: a fonte agora e o perfil enois do autor. A cada
            // `enoisPollMin` minutos o daemon olha se ha post novo e
            // compartilha o link no LinkedIn com uma legenda do proprio post.
            if (enoisPollMin > 0 && (time.now() - lastEnoisPoll) >= ((enoisPollMin as Long) * 60000L)) {
                pollEnoisOnce()
            }
            var active = store.activeSchedules()
            if (active.size() == 0) {
                // With the enois mirror ON, "no active schedules" is the NORMAL
                // state — the poll above is the trigger, and warning about it
                // every 5s filled the log with identical lines (measured
                // 2026-10-17). Without the mirror the warning is still the
                // honest answer, so it stays in that case.
                if (enoisPollMin <= 0) {
                    log.warn("daemon: nenhuma agenda ativa — use 'publisher schedule' (aguardando)")
                }
                time.sleep(5000)
                if (publisherStopRequested()) {
                    daemonCleanupPid()
                    return 0
                }
                continue
            }
            var bestDelayMs = 999999999999L
            var due = listOf<Schedule>()
            for (var item in active) {
                var s = item
                if (s.next_execution() == "") {
                    var recomputed = computeNext(s, nowStamp())
                    if (recomputed != "") {
                        store.saveSchedule(Schedule(s.name(), s.days(), s.interval_days(), s.anchor_date(), s.clock(), s.timezone(), s.topic(), s.mode(), s.target(), s.status(), recomputed, s.last_execution(), s.created_at(), nowStamp()))
                        var found = store.findSchedule(s.name())
                        if (found != null) {
                            s = found
                        }
                    }
                }
                if (s.next_execution() == "") {
                    continue
                }
                // Dispara a GERACAO `prepLeadMs` antes do horario; a publicacao
                // sai na hora exata pelo passe acima. O adiantamento vale SO
                // para a ocorrencia do RELOGIO: uma retentativa cai a poucos
                // minutos de distancia, ou seja, DENTRO da janela de 10 min, e
                // seria disparada no mesmo instante em que foi agendada — o
                // orcamento de retentativa queimaria em segundos e o horario
                // ficaria vazio (medido 2026-10-14). Retentativa roda na hora
                // dela.
                var lead = 0L
                if (isClockRun(s)) {
                    lead = prepLeadMs()
                }
                var delay = millisUntil(s.next_execution()) - lead
                if (delay <= 0) {
                    due.add(s)
                } else if (delay < bestDelayMs) {
                    bestDelayMs = delay
                }
            }
            if (due.size() > 0) {
                for (var s2 in due) {
                    var occIso = s2.next_execution()
                    // Um slot nunca pode derrubar o dia inteiro. Qualquer erro
                    // interno de UMA ocorrencia vira "failed" (retentavel) e o
                    // laco segue para o proximo slot — antes, uma excecao aqui
                    // subia ate o main, que imprimia "publisher: error" e
                    // encerrava o daemon (medido 2026-11-02).
                    var report = ExecReport("", "", "failed", "")
                    try {
                        report = runOccurrence(s2, occIso)
                    } catch (Throwable e) {
                        var em = e.toString()
                        log.error("agenda '" + s2.name() + "': falha interna em " + occIso + ": " + em)
                        report = ExecReport(s2.name() + "@" + occIso, "", "failed", em)
                    }
                    var next = computeNext(s2, occIso)
                    // A slot that did NOT post gets another attempt later today.
                    // "review" counts as a miss only in autonomous mode (in
                    // assisted mode REVIEW is the intended outcome).
                    var missed = report.result() == "skipped" || report.result() == "failed"
                    if (!missed && report.result() == "review" && effectiveMode(s2) == "autonomous") {
                        missed = true
                    }
                    if (missed && retryBudgetLeft(s2, occIso)) {
                        var retryAt = retryInstant(s2, occIso)
                        if (retryAt != "") {
                            next = retryAt
                            log.info("agenda '" + s2.name() + "': " + report.result() + " — nova tentativa em " + retryAt + " (orçamento de retentativa do dia)")
                        } else {
                            log.info("agenda '" + s2.name() + "': " + report.result() + " — sem espaco para nova tentativa antes do proximo horario")
                        }
                    }
                    store.saveSchedule(Schedule(s2.name(), s2.days(), s2.interval_days(), s2.anchor_date(), s2.clock(), s2.timezone(), s2.topic(), s2.mode(), s2.target(), s2.status(), next, occIso, s2.created_at(), nowStamp()))
                    log.info("agenda '" + s2.name() + "': ocorrencia " + occIso + " -> " + report.result() + "; proxima: " + next)
                }
            } else {
                var sleepMs = bestDelayMs
                if (sleepMs > 30000L) {
                    sleepMs = 30000L
                }
                if (sleepMs < 250L) {
                    sleepMs = 250L
                }
                var slept = 0L
                while (slept < sleepMs) {
                    time.sleep(200)
                    slept = slept + 200L
                    if (publisherStopRequested()) {
                        log.info("daemon: stop solicitado — encerrando limpo")
                        daemonCleanupPid()
                        return 0
                    }
                }
            }
        }
    }
}
