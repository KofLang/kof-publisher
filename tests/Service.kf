// E2E: the operational CLI — start / stop / status (§3) against the REAL built
// binary, in an ISOLATED home (KOF_PUBLISHER_HOME), so no test ever touches a
// real daemon, a real queue or LinkedIn.
//
// Proven here:
//   start launches a detached daemon that writes its OWN pid and heartbeats;
//   start REFUSES to launch a second one (no duplicate);
//   status separates "service up" from "authorized to publish";
//   stop is graceful (STOP file, then TERM on the exact pid) and preserves the
//   queue/state — stopping is not a wipe;
//   a stale pid file is not mistaken for a live daemon.

String envOr(String key, String dflt) {
    var v = config.env(key)
    if (v != null && v != "") {
        return v
    }
    return dflt
}

String publisherDir() {
    return envOr("KOF_PUBLISHER_DIR", "/home/mel/Documentos/kof-publisher")
}

String classpath() {
    var home = envOr("HOME", "/home/mel")
    var drv = envOr("KOF_SQLITE_JAR", home + "/.kof/deps/org/xerial/sqlite-jdbc/3.53.4.0/sqlite-jdbc-3.53.4.0.jar")
    return envOr("KOF_PUBLISHER_CLASSES", publisherDir() + "/build/classes")
        + ":" + home + "/.local/share/kof/lib/kof.jar:" + drv
}

String workDir(String name) {
    return "/tmp/kof-pub-tests/" + name
}

String runCmd(String cmd) {
    var r = process.run("sh", "-c", cmd + " 2>&1")
    return r.stdout + "||EXIT=" + r.exitCode
}

Int exitOf(String blob) {
    var i = blob.indexOf("||EXIT=")
    if (i < 0) {
        throw "no exit marker"
    }
    return blob.substring(i + 7).toInt()
}

String outOf(String blob) {
    var i = blob.indexOf("||EXIT=")
    return blob.substring(0, i)
}

Bool has(String hay, String needle) {
    return hay.indexOf(needle) >= 0
}

// A profile with a long-interval schedule (so the daemon never fires during the
// test) and one pre-existing queued publication (to prove stop preserves it).
String serviceCompany() {
    var c = "# company\nname: Servico\n\n# topics\ntopics:\n  - engenharia\n\n"
    c = c + "# publishing\ntimezone: America/Sao_Paulo\nmode: assisted\ntarget: linkedin\n\n"
    c = c + "# schedule nightly\nevery: 365\nat: 03:00\nmode: assisted\ntarget: linkedin\n"
    return c
}

void prepare(String name) {
    var r = process.run("sh", "-c", "rm -rf '" + workDir(name) + "' && mkdir -p '" + workDir(name) + "/home'")
    assert(r.exitCode == 0, "prepare " + name + ": " + r.stderr)
    File(workDir(name) + "/company.kofmd").writeText(serviceCompany())
}

String cli(String name, String args) {
    // AUDIT FIX (AUD-7): bounded. `start` used to hang forever (the detached
    // daemon kept the captured stdout pipe open); without a timeout a regression
    // would hang the whole suite instead of failing one test. `timeout` turns
    // "never returns" into exit 124, which the assertions can see.
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " timeout 60 java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

// Never leave a daemon behind, whatever the assertions do.
void forceCleanup(String name) {
    runCmd("if [ -f '" + workDir(name) + "/home/publisher.pid' ]; then kill -TERM $(cat '" + workDir(name) + "/home/publisher.pid') 2>/dev/null || true; fi; true")
    runCmd("sleep 1")
}

test "service: start launches a detached daemon, refuses a duplicate, status is honest, stop is graceful" {
    prepare("svc-life")
    var s = cli("svc-life", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)
    assert(has(outOf(s), "publisher iniciado"), s)

    var pidFile = runCmd("cat '" + workDir("svc-life") + "/home/publisher.pid'")
    var pid = outOf(pidFile).trim()
    assert(exitOf(pidFile) == 0 && pid != "", "no pid file: " + pidFile)

    // liveness: the pid is alive and is OUR daemon (not a recycled number)
    var alive = runCmd("kill -0 " + pid + " && echo ALIVE || echo DEAD")
    assert(has(outOf(alive), "ALIVE"), alive)
    var cmdline = runCmd("tr '\\0' ' ' < /proc/" + pid + "/cmdline")
    assert(has(outOf(cmdline), "Default.Main"), cmdline)
    assert(has(outOf(cmdline), "daemon"), cmdline)

    // heartbeat file was written by the daemon
    var hb = runCmd("test -s '" + workDir("svc-life") + "/home/publisher.heartbeat' && echo HB || echo NOHB")
    assert(has(outOf(hb), "HB"), hb)

    // status: service up, but publishing is still ASSISTED (two separate facts)
    var st = cli("svc-life", "status --company company.kofmd --store pub.db")
    assert(exitOf(st) == 0, st)
    var so = outOf(st)
    assert(has(so, "service      : ATIVO"), so)
    assert(has(so, "publicacao   : ASSISTIDA"), so)
    assert(has(so, "proximo slot"), so)

    // NO DUPLICATE: a second start refuses instead of launching another daemon
    var s2 = cli("svc-life", "start --company company.kofmd --store pub.db")
    assert(exitOf(s2) == 0, s2)
    assert(has(outOf(s2), "ja ativo"), s2)
    // count daemons whose working dir is THIS test's dir (the daemon's argv is
    // relative, so /proc/<pid>/cwd is what identifies it)
    // count the DAEMON JVMs whose working dir is THIS test's dir. A pid's argv
    // is relative and the `sh` wrapper shares the cwd, so we match on the
    // executable being java; 'daemo[n]' keeps this shell from matching itself.
    var count = runCmd("for p in $(pgrep -f 'Default.Main daemo[n]'); do echo $(readlink /proc/$p/cwd) $(readlink /proc/$p/exe); done | grep -c '^" + workDir("svc-life") + " .*java$'")
    assert(exitOf(count) == 0 && outOf(count).trim() == "1", "expected exactly one daemon, got:\n" + count)
    // and the pid file still names the SAME process (start did not replace it)
    var pidFile2 = runCmd("cat '" + workDir("svc-life") + "/home/publisher.pid'")
    assert(outOf(pidFile2).trim() == pid, "pid changed on refused start:\n" + pidFile2)

    // graceful stop
    var stop = cli("svc-life", "stop")
    assert(exitOf(stop) == 0, stop)
    assert(has(outOf(stop), "publisher parado"), stop)
    var dead = runCmd("kill -0 " + pid + " 2>/dev/null && echo ALIVE || echo DEAD")
    assert(has(outOf(dead), "DEAD"), dead)

    // status now reports stopped
    var st2 = cli("svc-life", "status --company company.kofmd --store pub.db")
    assert(has(outOf(st2), "service      : parado"), st2)
    forceCleanup("svc-life")
}

test "service: stop preserves the queue and state; a stale pid file is not a live daemon" {
    prepare("svc-state")
    // seed the queue through the real CLI: a schedule + a review proposal
    var sync = cli("svc-state", "sync --company company.kofmd --store pub.db")
    assert(exitOf(sync) == 0, sync)

    var s = cli("svc-state", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)
    var stop = cli("svc-state", "stop")
    assert(exitOf(stop) == 0, stop)

    // the schedule survived the stop (state was preserved, not wiped)
    var scheds = cli("svc-state", "schedules --store pub.db")
    assert(exitOf(scheds) == 0, scheds)
    assert(has(outOf(scheds), "nightly"), scheds)

    // a pid file pointing at a dead pid must be reported as stale, never as
    // "active" — and start must clean it up rather than refuse.
    var junk = runCmd("echo 999999 > '" + workDir("svc-state") + "/home/publisher.pid'")
    assert(exitOf(junk) == 0, junk)
    var st = cli("svc-state", "status --company company.kofmd --store pub.db")
    assert(exitOf(st) == 0, st)
    assert(has(outOf(st), "service      : parado"), outOf(st))

    // stop on a stale pid file is a clean no-op, not an error
    var stop2 = cli("svc-state", "stop")
    assert(exitOf(stop2) == 0, stop2)
    assert(has(outOf(stop2), "ja estava parado"), stop2)
    forceCleanup("svc-state")
}

test "service: start never flips assisted to autonomous" {
    prepare("svc-mode")
    var s = cli("svc-mode", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)
    var st = cli("svc-mode", "status --company company.kofmd --store pub.db")
    assert(exitOf(st) == 0, st)
    // the profile declares assisted; bringing the service up must not change it
    assert(has(outOf(st), "mode=assisted"), outOf(st))
    assert(has(outOf(st), "publicacao   : ASSISTIDA"), outOf(st))
    var stop = cli("svc-mode", "stop")
    assert(exitOf(stop) == 0, stop)
    forceCleanup("svc-mode")
}

// REGRESSION (AUD-4): concurrent `start` calls used to race between "no pid
// file yet" and the daemon writing its pid, launching TWO daemons for one
// profile. The start lock must serialize them so exactly one daemon survives.
test "service: concurrent starts launch exactly one daemon" {
    prepare("svc-race")
    // four starts at once, each with its own timeout so a regression hangs the
    // test rather than the suite
    var cmd = "cd '" + workDir("svc-race") + "'"
        + " && for i in 1 2 3 4; do ( KOF_PUBLISHER_HOME='" + workDir("svc-race") + "/home'"
        + " timeout 40 java -cp '" + classpath() + "' Default.Main start --company company.kofmd --store pub.db > s$i.txt 2>&1 ) & done; wait; echo RACEDONE"
    var r = runCmd(cmd)
    assert(has(outOf(r), "RACEDONE"), "starts did not finish:\n" + r)

    // exactly one daemon, identified by cwd + java executable
    var count = runCmd("for p in $(pgrep -f 'Default.Main daemo[n]'); do echo $(readlink /proc/$p/cwd) $(readlink /proc/$p/exe); done | grep -c '^" + workDir("svc-race") + " .*java$'")
    assert(exitOf(count) == 0 && outOf(count).trim() == "1", "expected exactly one daemon after 4 concurrent starts, got:\n" + count)
    // the losers did not error out; they reported the winner
    var active = runCmd("grep -l 'ja ativo' '" + workDir("svc-race") + "'/s*.txt | wc -l")
    assert(outOf(active).trim() == "3", "losers should report 'ja ativo', got:\n" + active)
    // the lock is released (not left behind to block the next start)
    var lock = runCmd("test -d '" + workDir("svc-race") + "/home/publisher.start.lock' && echo HELD || echo FREE")
    assert(has(outOf(lock), "FREE"), "start lock was left behind:\n" + lock)

    var stop = cli("svc-race", "stop")
    assert(exitOf(stop) == 0, stop)
    forceCleanup("svc-race")
}

// ---------------------------------------------------------------------------
// REGRESSION (Fase 8): the DAEMON does research, not only the manual `plan`.
//
// The daemon used to generate from the profile and the GitHub digest alone —
// `runOccurrence` never called the research pipeline, so a clock that fires at
// 12:00 would produce a "news" post without ever consulting a current source,
// and would record no pauta for the next cycle to avoid repeating. Both are
// required of the recurring service, so this test pins them down.
//
// The occurrence is forced to fire immediately by moving the schedule's
// next_execution into the past AFTER `sync` computed it: deterministic, no
// sleeping until a wall-clock slot.
// ---------------------------------------------------------------------------

String startResearch(String name, String port, String mode) {
    runCmd("pkill -f 'fake_researc[h].py " + port + "' || true; true")
    var up = runCmd("{ python3 '" + publisherDir() + "/tests/fake_research.py' " + port + " " + mode + " > '" + workDir(name) + "/rs.log' 2>&1 & echo $! > '" + workDir(name) + "/rs.pid'; }; sleep 1; curl -s -m 4 http://127.0.0.1:" + port + "/health")
    assert(exitOf(up) == 0 && outOf(up).trim() == "ok", up)
    return outOf(up)
}

void stopResearch(String name) {
    runCmd("kill $(cat '" + workDir(name) + "/rs.pid') 2>/dev/null || true")
}

String startLm(String name, String port) {
    runCmd("pkill -f 'fake_lm_persona[l].py " + port + "' || true; true")
    var up = runCmd("{ python3 '" + publisherDir() + "/tests/fake_lm_personal.py' " + port + " distinct > '" + workDir(name) + "/lm.log' 2>&1 & echo $! > '" + workDir(name) + "/lm.pid'; }; sleep 1; curl -s -m 4 http://127.0.0.1:" + port + "/api/tags | grep -c models")
    assert(exitOf(up) == 0 && outOf(up).trim() == "1", up)
    return outOf(up)
}

void stopLm(String name) {
    runCmd("kill $(cat '" + workDir(name) + "/lm.pid') 2>/dev/null || true")
}

// A one-category profile whose only slot is the news slot, plus the schedule
// that fires it.
// The same profile but AUTONOMOUS. The retry and the prepare-ahead only exist
// in autonomous mode: in assisted, REVIEW is the intended outcome and there is
// no "missed" slot and nothing scheduled to publish. The tests below used the
// assisted fixture and were measuring the wrong mode (measured 2026-10-13).
String autonomousCompany() {
    // target dryrun de proposito: o teste precisa OBSERVAR a publicacao, e um
    // target linkedin aqui tentaria a rede real. dryrun grava o texto num
    // diretorio e devolve "published", que e o que a assercao mede.
    return researchCompany().replace("mode: assisted", "mode: autonomous").replace("target: linkedin", "target: dryrun")
}

String researchCompany() {
    var c = "# company\nname: Daemon Pesquisa\n\n# topics\ntopics:\n  - engenharia de software\n\n"
    c = c + "# publishing\ntimezone: America/Sao_Paulo\nmode: assisted\ntarget: linkedin\n\n"
    c = c + "# editorial\nrequire_material: true\nresearch:\n  - hackernews\n  - devto\nresearch_max_age_hours: 168\nretention_records: 10000\nretention_max_gb: 20\n\n"
    c = c + "# category noon\nclock: 12:00\nlabel: noticia\nfunction: noticias\nangle: noticia recente\n\n"
    c = c + "# schedule noon\ndays:\n  - mon\n  - tue\n  - wed\n  - thu\n  - fri\n  - sat\n  - sun\nat: 12:00\nmode: assisted\ntarget: linkedin\n"
    return c
}

// The CLI with the research + LM fixtures wired in, so the DAEMON (which
// inherits this process's environment) reaches them too.
String cliFixtures(String name, String rsPort, String lmPort, String args) {
    var base = "http://127.0.0.1:" + rsPort
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " KOF_RESEARCH_HN_API='" + base + "/hn'"
        + " KOF_RESEARCH_DEVTO_API='" + base + "/devto'"
        + " KOF_RESEARCH_LOBSTERS_API='" + base + "/lobsters'"
        + " KOF_RESEARCH_TIMEOUT=10"
        + " KOF_LM_URL=http://127.0.0.1:" + lmPort + " KOF_LM_MODEL=fake-lm KOF_LM_TOKENS=400 KOF_LM_TIMEOUT=25"
        + " timeout 60 java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

test "service: a fired occurrence runs the research pipeline and records the pauta" {
    // A previous failing run may have leaked a daemon holding this workdir (the
    // assertions below cannot use try/finally in this harness). Kill it first so
    // a stale process cannot write into the database this run recreates.
    runCmd("for p in $(pgrep -f 'Default.Main daemo[n]'); do d=$(readlink /proc/$p/cwd 2>/dev/null); if [ \"$d\" = '" + workDir("svc-research") + "' ]; then kill -9 $p 2>/dev/null || true; fi; done; true")
    prepare("svc-research")
    File(workDir("svc-research") + "/company.kofmd").writeText(researchCompany())
    startResearch("svc-research", "11960", "normal")
    startLm("svc-research", "11961")

    // the agenda exists first (sync), then its next_execution is moved into the
    // RECENT past so the daemon sees it as due on its very first loop. It has
    // to be RECENT: recovery deliberately treats an instant overdue by more
    // than 10 minutes as stale and recomputes it forward (a restart must not
    // replay a long-dead slot), so a far-past stamp would be silently reset.
    var sync = cliFixtures("svc-research", "11960", "11961", "sync --company company.kofmd --store pub.db")
    assert(exitOf(sync) == 0, sync)
    var moved = runCmd("python3 -c \"import sqlite3,datetime; tz=datetime.timezone(datetime.timedelta(hours=-3)); t=(datetime.datetime.now(tz)-datetime.timedelta(minutes=2)).strftime('%Y-%m-%dT%H:%M:%S-03:00'); c=sqlite3.connect('" + workDir("svc-research") + "/pub.db'); c.execute(\\\"update schedule set next_execution=? where name='noon'\\\", (t,)); c.commit(); print(t)\"")
    assert(has(outOf(moved), "-03:00"), "schedule was not moved into the recent past:\n" + moved)

    var s = cliFixtures("svc-research", "11960", "11961", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)
    assert(has(outOf(s), "publisher iniciado"), s)

    // Wait for the occurrence to be COMPLETE, not merely started: the research
    // line is logged before generation, and the pauta/publication asserted
    // below only exist once the whole pipeline has run. The end marker is the
    // "-> review" line the daemon writes after recording the occurrence.
    var logPath = workDir("svc-research") + "/home/publisher.log"
    var waited = 0
    var fired = ""
    while (waited < 90000) {
        // `; true` and not `|| echo 0`: grep -c PRINTS "0" and exits nonzero on
        // no match, so the `||` form emits "0\n0" and the loop would break on
        // the first iteration, before the daemon ever wrote the line.
        fired = runCmd("grep -c \"ocorrencia noon@.* -> review\" '" + logPath + "' 2>/dev/null; true")
        if (outOf(fired).trim() != "0") {
            break
        }
        runCmd("sleep 2")
        waited = waited + 2000
    }
    var log = runCmd("cat '" + logPath + "' 2>/dev/null")
    var logOut = outOf(log)
    // 1. the DAEMON consulted the sources (this is the regression)
    assert(has(logOut, "pesquisa 12:00:"), "daemon never ran research:\n" + logOut)
    // 2. it did not fabricate when a source failed: the note names the source
    assert(has(logOut, "hackernews") || has(logOut, "devto"), logOut)

    // 3. the occurrence is in the ledger, and it is in REVIEW (assisted mode)
    var hist = cliFixtures("svc-research", "11960", "11961", "history --store pub.db")
    assert(exitOf(hist) == 0, hist)
    assert(has(outOf(hist), "noon"), outOf(hist))

    var st = cliFixtures("svc-research", "11960", "11961", "db-stats --company company.kofmd --store pub.db")
    var stOut = outOf(st)
    assert(has(stOut, "ocorrencias  : 1"), stOut)
    // the pauta behind the draft was persisted -> the next cycle can see the
    // topic was already used (this is the memory the daemon previously lacked)
    assert(has(stOut, "pautas       : 1"), stOut)
    assert(has(stOut, "fontes       : "), stOut)

    // 4. nothing was published, and the mode is still assisted
    var pub = cliFixtures("svc-research", "11960", "11961", "list --status published --company company.kofmd --store pub.db")
    assert(has(outOf(pub), "nenhuma"), pub)
    var status = cliFixtures("svc-research", "11960", "11961", "status --company company.kofmd --store pub.db")
    assert(has(outOf(status), "publicacao   : ASSISTIDA"), outOf(status))

    var stop = cliFixtures("svc-research", "11960", "11961", "stop")
    assert(exitOf(stop) == 0, stop)
    forceCleanup("svc-research")
    stopLm("svc-research")
    stopResearch("svc-research")
}

// Same as cliFixtures, plus a SHORT retry window so the retry is observable
// inside a test (the default is 20 minutes).
String cliFixturesRetry(String name, String rsPort, String lmPort, String args) {
    var base = "http://127.0.0.1:" + rsPort
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " KOF_RESEARCH_HN_API='" + base + "/hn'"
        + " KOF_RESEARCH_DEVTO_API='" + base + "/devto'"
        + " KOF_RESEARCH_LOBSTERS_API='" + base + "/lobsters'"
        + " KOF_RESEARCH_TIMEOUT=10"
        + " KOF_PUBLISHER_RETRY_DELAY_MIN=1"
        + " KOF_PUBLISHER_RETRY_MAX=2"
        + " KOF_LM_URL=http://127.0.0.1:" + lmPort + " KOF_LM_MODEL=fake-lm KOF_LM_TOKENS=400 KOF_LM_TIMEOUT=25"
        + " timeout 60 java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

// A slot that cannot post gets another attempt LATER THE SAME DAY, instead of
// waiting for tomorrow. This is the "sempre haja postagem nos horarios" rule:
// a skip (no candidate right now) or a factual-gate block is retried.
test "service: a slot that did not post is retried later the same day" {
    runCmd("for p in $(pgrep -f 'Default.Main daemo[n]'); do d=$(readlink /proc/$p/cwd 2>/dev/null); if [ \"$d\" = '" + workDir("svc-retry") + "' ]; then kill -9 $p 2>/dev/null || true; fi; done; true")
    prepare("svc-retry")
    File(workDir("svc-retry") + "/company.kofmd").writeText(autonomousCompany())
    // "empty" = every source answers a well-formed but EMPTY list, so the news
    // slot has no candidate and SKIPS deterministically.
    startResearch("svc-retry", "11970", "empty")
    startLm("svc-retry", "11971")

    var sync = cliFixturesRetry("svc-retry", "11970", "11971", "sync --company company.kofmd --store pub.db")
    assert(exitOf(sync) == 0, sync)
    runCmd("python3 -c \"import sqlite3,datetime; tz=datetime.timezone(datetime.timedelta(hours=-3)); t=(datetime.datetime.now(tz)-datetime.timedelta(minutes=2)).strftime('%Y-%m-%dT%H:%M:%S-03:00'); c=sqlite3.connect('" + workDir("svc-retry") + "/pub.db'); c.execute(\\\"update schedule set next_execution=? where name='noon'\\\", (t,)); c.commit()\"")

    var s = cliFixturesRetry("svc-retry", "11970", "11971", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)

    var logPath = workDir("svc-retry") + "/home/publisher.log"
    var waited = 0
    var found = ""
    while (waited < 90000) {
        found = runCmd("grep -c 'nova tentativa em' '" + logPath + "' 2>/dev/null; true")
        if (outOf(found).trim() != "0") {
            break
        }
        runCmd("sleep 2")
        waited = waited + 2000
    }
    var log = runCmd("cat '" + logPath + "' 2>/dev/null")
    assert(has(outOf(log), "nova tentativa em"), "a retentativa nao foi agendada:\n" + outOf(log))

    // The schedule's next_execution must now be a NEAR-FUTURE instant (the retry),
    // not tomorrow's 12:00.
    var soon = runCmd("python3 -c \"import sqlite3,datetime; c=sqlite3.connect('" + workDir("svc-retry") + "/pub.db'); nx=c.execute(\\\"select next_execution from schedule where name='noon'\\\").fetchone()[0]; tz=datetime.timezone(datetime.timedelta(hours=-3)); d=datetime.datetime.strptime(nx[:19],'%Y-%m-%dT%H:%M:%S').replace(tzinfo=tz); now=datetime.datetime.now(tz); delta=(d-now).total_seconds(); print('SOON' if 0 <= delta <= 300 else ('PAST' if delta < 0 else 'FAR'))\"")
    assert(has(outOf(soon), "SOON"), "next_execution nao foi para a retentativa: " + outOf(soon))

    var stop = cliFixturesRetry("svc-retry", "11970", "11971", "stop")
    assert(exitOf(stop) == 0, stop)
    forceCleanup("svc-retry")
    stopLm("svc-retry")
    stopResearch("svc-retry")
}

String cliFixturesPrep(String name, String rsPort, String lmPort, String args) {
    var base = "http://127.0.0.1:" + rsPort
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " KOF_RESEARCH_HN_API='" + base + "/hn'"
        + " KOF_RESEARCH_DEVTO_API='" + base + "/devto'"
        + " KOF_RESEARCH_LOBSTERS_API='" + base + "/lobsters'"
        + " KOF_RESEARCH_TIMEOUT=10"
        + " KOF_PUBLISHER_PREP_LEAD_MIN=1"
        + " KOF_LM_URL=http://127.0.0.1:" + lmPort + " KOF_LM_MODEL=fake-lm KOF_LM_TOKENS=400 KOF_LM_TIMEOUT=25"
        + " timeout 60 java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

// PREPARE-AHEAD: o texto e gerado ANTES do horario e publicado na hora exata.
test "service: a slot prepares ahead and publishes at the scheduled time" {
    runCmd("for p in $(pgrep -f 'Default.Main daemo[n]'); do d=$(readlink /proc/$p/cwd 2>/dev/null); if [ \"$d\" = '" + workDir("svc-prep") + "' ]; then kill -9 $p 2>/dev/null || true; fi; done; true")
    prepare("svc-prep")
    File(workDir("svc-prep") + "/company.kofmd").writeText(autonomousCompany())
    startResearch("svc-prep", "11990", "normal")
    startLm("svc-prep", "11991")

    var sync = cliFixturesPrep("svc-prep", "11990", "11991", "sync --company company.kofmd --store pub.db")
    assert(exitOf(sync) == 0, sync)
    // A ocorrencia precisa ser a do RELOGIO (HH:MM batendo com o clock da
    // agenda): o adiantamento so vale para ela — uma retentativa, por cair a
    // poucos minutos, nao e adiantada. Entao a agenda e movida para o proximo
    // minuto cheio, ~40s a frente, e o PREP (lead de 1min) ja esta vencido
    // enquanto a PUBLICACAO ainda nao — exatamente o que se quer medir.
    runCmd("python3 -c \"import sqlite3,datetime; tz=datetime.timezone(datetime.timedelta(hours=-3)); now=datetime.datetime.now(tz); t=(now+datetime.timedelta(seconds=45)).replace(second=0,microsecond=0); t=t+datetime.timedelta(minutes=1) if (t-now).total_seconds()<20 else t; iso=t.strftime('%Y-%m-%dT%H:%M:%S-03:00'); clk=t.strftime('%H:%M'); c=sqlite3.connect('" + workDir("svc-prep") + "/pub.db'); c.execute(\\\"update schedule set next_execution=?, clock=? where name='noon'\\\", (iso,clk)); c.commit()\"")

    var s = cliFixturesPrep("svc-prep", "11990", "11991", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)

    var logPath = workDir("svc-prep") + "/home/publisher.log"
    var waited = 0
    var found = ""
    while (waited < 60000) {
        found = runCmd("grep -c 'texto pronto' '" + logPath + "' 2>/dev/null; true")
        if (outOf(found).trim() != "0") {
            break
        }
        runCmd("sleep 2")
        waited = waited + 2000
    }
    var log = runCmd("cat '" + logPath + "' 2>/dev/null")
    assert(has(outOf(log), "texto pronto"), "nao preparou com antecedencia:\n" + outOf(log))

    // O rascunho esta AGENDADO (nao publicado) — gerado antes, esperando a hora.
    var st = runCmd("python3 -c \"import sqlite3; c=sqlite3.connect('" + workDir("svc-prep") + "/pub.db'); print(c.execute(\\\"select status from publication\\\").fetchone()[0])\"")
    assert(has(outOf(st), "scheduled"), "o rascunho nao ficou agendado: " + outOf(st))

    // Ao chegar o horario, o passe de agendados publica.
    var waited2 = 0
    var pub = ""
    while (waited2 < 90000) {
        pub = runCmd("python3 -c \"import sqlite3; c=sqlite3.connect('" + workDir("svc-prep") + "/pub.db'); r=c.execute(\\\"select status from publication\\\").fetchone(); print(r[0] if r else '')\"")
        if (has(outOf(pub), "published")) {
            break
        }
        runCmd("sleep 3")
        waited2 = waited2 + 3000
    }
    assert(has(outOf(pub), "published"), "nao publicou na hora agendada: " + outOf(pub) + "\n" + runCmd("tail -6 '" + logPath + "'"))

    var stop = cliFixturesPrep("svc-prep", "11990", "11991", "stop")
    assert(exitOf(stop) == 0, stop)
    forceCleanup("svc-prep")
    stopLm("svc-prep")
    stopResearch("svc-prep")
}

String cliFixturesFault(String name, String rsPort, String lmPort, String args) {
    var base = "http://127.0.0.1:" + rsPort
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " KOF_RESEARCH_HN_API='" + base + "/hn'"
        + " KOF_RESEARCH_DEVTO_API='" + base + "/devto'"
        + " KOF_RESEARCH_LOBSTERS_API='" + base + "/lobsters'"
        + " KOF_RESEARCH_TIMEOUT=10"
        + " KOF_LM_URL=http://127.0.0.1:" + lmPort + " KOF_LM_MODEL=fake-lm KOF_LM_TOKENS=400 KOF_LM_TIMEOUT=5"
        + " timeout 60 java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

// Same wiring as cliFixturesFault, but with a SHORT same-day retry delay so the
// retry of a failed slot happens inside the test window.
String cliFixturesFlaky(String name, String rsPort, String lmPort, String args) {
    var base = "http://127.0.0.1:" + rsPort
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " KOF_RESEARCH_HN_API='" + base + "/hn'"
        + " KOF_RESEARCH_DEVTO_API='" + base + "/devto'"
        + " KOF_RESEARCH_LOBSTERS_API='" + base + "/lobsters'"
        + " KOF_RESEARCH_TIMEOUT=10"
        + " KOF_PUBLISHER_RETRY_MAX=3"
        + " KOF_PUBLISHER_RETRY_DELAY_MIN=1"
        + " KOF_PUBLISHER_PREP_LEAD_MIN=0"
        + " KOF_LM_URL=http://127.0.0.1:" + lmPort + " KOF_LM_MODEL=fake-lm KOF_LM_TOKENS=400 KOF_LM_TIMEOUT=5"
        + " timeout 60 java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

// REGRESSÃO 2026-11-02: o daemon MORREU às 11:54 no meio do dia.
//
// O LM estourou o timeout e a excecao chegou como algo que nao e String. O
// catch da geracao so tratava String, entao a excecao subiu ate o main, que
// imprimiu "publisher: error" e encerrou o PROCESSO — os slots das 15:00 e
// 18:00 nunca rodaram. Aqui o modelo sempre falha (timeout de verdade, a
// fixture dorme mais que o deadline e fecha), e o que se mede e o essencial:
// a ocorrencia se resolve sozinha e o daemon continua VIVO.
test "service: an LM failure skips the slot and never kills the daemon" {
    runCmd("for p in $(pgrep -f 'Default.Main daemo[n]'); do d=$(readlink /proc/$p/cwd 2>/dev/null); if [ \"$d\" = '" + workDir("svc-lmdown") + "' ]; then kill -9 $p 2>/dev/null || true; fi; done; true")
    prepare("svc-lmdown")
    File(workDir("svc-lmdown") + "/company.kofmd").writeText(autonomousCompany())
    startResearch("svc-lmdown", "11972", "normal")
    runCmd("pkill -f 'fake_lm_serv[e]r.py 11973' || true; true")
    var up = runCmd("{ python3 '" + publisherDir() + "/tests/fake_lm_server.py' 11973 timeout > '" + workDir("svc-lmdown") + "/lm.log' 2>&1 & echo $! > '" + workDir("svc-lmdown") + "/lm.pid'; }; sleep 1; curl -s -m 4 http://127.0.0.1:11973/api/tags | grep -c models")
    assert(exitOf(up) == 0 && outOf(up).trim() == "1", up)

    var sync = cliFixturesFault("svc-lmdown", "11972", "11973", "sync --company company.kofmd --store pub.db")
    assert(exitOf(sync) == 0, sync)
    // Agenda de RELÓGIO (HH:MM == clock): o adiantamento gera agora e prepara
    // a ocorrencia sem esperar a hora; sem isso o teste dormiria ate o
    // horario real.
    runCmd("python3 -c \"import sqlite3,datetime; tz=datetime.timezone(datetime.timedelta(hours=-3)); now=datetime.datetime.now(tz); t=(now+datetime.timedelta(minutes=2)).replace(second=0,microsecond=0); t=t+datetime.timedelta(minutes=1) if (t-now).total_seconds()<100 else t; iso=t.strftime('%Y-%m-%dT%H:%M:%S-03:00'); clk=t.strftime('%H:%M'); c=sqlite3.connect('" + workDir("svc-lmdown") + "/pub.db'); c.execute(\\\"update schedule set next_execution=?, clock=? where name='noon'\\\", (iso,clk)); c.commit()\"")

    var s = cliFixturesFault("svc-lmdown", "11972", "11973", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)

    var logPath = workDir("svc-lmdown") + "/home/publisher.log"
    var waited = 0
    var seen = ""
    while (waited < 150000) {
        seen = runCmd("grep -c 'request failed\\|no response from' '" + logPath + "' 2>/dev/null; true")
        if (outOf(seen).trim() != "0") {
            break
        }
        runCmd("sleep 2")
        waited = waited + 2000
    }
    var log = runCmd("cat '" + logPath + "' 2>/dev/null")
    // A falha do modelo vira SKIP com a causa honesta (nunca lixo JSON no texto).
    assert(has(outOf(log), "request failed") || has(outOf(log), "no response from"), "a falha do LM nao foi tratada:\n" + outOf(log))
    assert(!has(outOf(log), "publisher: error"), "a excecao escapou ate o main (o processo morreu):\n" + outOf(log))

    // O daemon continua de pe depois do erro (heartbeat novo e pid vivo).
    var alive = runCmd("sleep 3; cat '" + workDir("svc-lmdown") + "/home/publisher.pid'")
    var pid = outOf(alive).trim()
    var running = runCmd("kill -0 '" + pid + "' && echo VIVO || echo MORTO")
    assert(has(outOf(running), "VIVO"), "o daemon morreu apos a falha do LM:\n" + outOf(log))

    // E a ocorrencia ficou registrada como ignorada (retentavel), nao presa.
    var st = runCmd("python3 -c \"import sqlite3; c=sqlite3.connect('" + workDir("svc-lmdown") + "/pub.db'); print(c.execute(\\\"select result from occurrence\\\").fetchone()[0])\"")
    assert(has(outOf(st), "skipped"), "a ocorrencia nao foi registrada como skipped: " + outOf(st))

    var stop = cliFixturesFault("svc-lmdown", "11972", "11973", "stop")
    assert(exitOf(stop) == 0, stop)
    forceCleanup("svc-lmdown")
    runCmd("kill $(cat '" + workDir("svc-lmdown") + "/lm.pid') 2>/dev/null || true")
    stopResearch("svc-lmdown")
}

// REGRESSÃO 2026-11-02 (segunda metade): sobreviver NAO basta — o horario tem de
// ser RETENTADO e o post tem de SAIR.
//
// O primeiro teste prova que uma falha de LM nao mata o processo. Faltava o que
// o autor de fato pediu: "ele tem que retentar e publicar corretamente". A
// fixture `flaky` falha SO na primeira geracao e responde normalmente depois. A
// falha acontece DEPOIS da hora do slot (o retry ja venceu), que e o caso que
// antes era abandonado com "sem espaco para nova tentativa" — o slot so voltava
// no dia seguinte. Aqui a retentativa tem de rodar e a publicacao tem de sair.
test "service: a slot whose LM failed is retried and actually publishes" {
    runCmd("for p in $(pgrep -f 'Default.Main daemo[n]'); do d=$(readlink /proc/$p/cwd 2>/dev/null); if [ \"$d\" = '" + workDir("svc-flaky") + "' ]; then kill -9 $p 2>/dev/null || true; fi; done; true")
    prepare("svc-flaky")
    File(workDir("svc-flaky") + "/company.kofmd").writeText(autonomousCompany())
    startResearch("svc-flaky", "11978", "normal")
    runCmd("pkill -f 'fake_lm_serv[e]r.py 11979' || true; true")
    var up = runCmd("{ python3 '" + publisherDir() + "/tests/fake_lm_server.py' 11979 flaky > '" + workDir("svc-flaky") + "/lm.log' 2>&1 & echo $! > '" + workDir("svc-flaky") + "/lm.pid'; }; sleep 1; curl -s -m 4 http://127.0.0.1:11979/api/tags | grep -c models")
    assert(exitOf(up) == 0 && outOf(up).trim() == "1", up)

    // Retentativa curta (1 min) e sem adiantamento, para o teste caber no tempo
    // e para a falha cair FORA da janela de prep (o caso antes abandonado).
    var sync = cliFixturesFlaky("svc-flaky", "11978", "11979", "sync --company company.kofmd --store pub.db")
    assert(exitOf(sync) == 0, sync)
    // Slot ~1 min no futuro, com HH:MM == clock. O daemon roda a ocorrencia
    // imediatamente (o retry ja venceu) e a primeira geracao falha.
    runCmd("python3 -c \"import sqlite3,datetime; tz=datetime.timezone(datetime.timedelta(hours=-3)); now=datetime.datetime.now(tz); t=(now+datetime.timedelta(seconds=40)).replace(second=0,microsecond=0); t=t+datetime.timedelta(minutes=1) if (t-now).total_seconds()<15 else t; iso=t.strftime('%Y-%m-%dT%H:%M:%S-03:00'); clk=t.strftime('%H:%M'); c=sqlite3.connect('" + workDir("svc-flaky") + "/pub.db'); c.execute(\\\"update schedule set next_execution=?, clock=? where name='noon'\\\", (iso,clk)); c.commit()\"")

    var s = cliFixturesFlaky("svc-flaky", "11978", "11979", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)

    var logPath = workDir("svc-flaky") + "/home/publisher.log"
    var waited = 0
    var published = ""
    while (waited < 240000) {
        published = runCmd("python3 -c \"import sqlite3; c=sqlite3.connect('" + workDir("svc-flaky") + "/pub.db'); r=c.execute(\\\"select status from publication\\\").fetchone(); print(r[0] if r else '')\"")
        if (has(outOf(published), "published")) {
            break
        }
        runCmd("sleep 3")
        waited = waited + 3000
    }
    var log = runCmd("cat '" + logPath + "' 2>/dev/null")
    assert(!has(outOf(log), "publisher: error"), "o processo morreu no meio do dia:\n" + outOf(log))
    assert(has(outOf(log), "request failed") || has(outOf(log), "no response from"), "a falha do LM nao apareceu no log:\n" + outOf(log))
    assert(has(outOf(log), "nova tentativa em"), "o horario nao foi reagendado para retentativa:\n" + outOf(log))
    // O QUE IMPORTA: apos a falha, a retentativa publicou de verdade.
    assert(has(outOf(published), "published"), "a retentativa NAO publicou (estado: " + outOf(published) + "):\n" + outOf(log))

    var stop = cliFixturesFlaky("svc-flaky", "11978", "11979", "stop")
    assert(exitOf(stop) == 0, stop)
    forceCleanup("svc-flaky")
    runCmd("kill $(cat '" + workDir("svc-flaky") + "/lm.pid') 2>/dev/null || true")
    stopResearch("svc-flaky")
}

// REGRESSION 2026-11-07: one slot, TWO posts.
//
// The 06:00 slot published at 05:53. The retry was scheduled for 05:56, and
// because that instant was still AHEAD of the clock the retry generated a
// fresh draft and published it too — two LinkedIn posts for one slot. Two
// causes, both fixed: "already claimed" was counted as a miss, and a slot that
// had already posted was still eligible for a retry.
test "service: a slot that already published is never retried (no duplicate post)" {
    runCmd("for p in $(pgrep -f 'Default.Main daemo[n]'); do d=$(readlink /proc/$p/cwd 2>/dev/null); if [ \"$d\" = '" + workDir("svc-dup") + "' ]; then kill -9 $p 2>/dev/null || true; fi; done; true")
    prepare("svc-dup")
    File(workDir("svc-dup") + "/company.kofmd").writeText(autonomousCompany())
    // "empty" = the sources answer well-formed but EMPTY lists, so this run
    // has no candidate at all and SKIPS deterministically. The skip is the
    // "miss" that used to schedule the duplicate retry.
    startResearch("svc-dup", "11960", "empty")
    startLm("svc-dup", "11961")

    var sync = cliFixturesRetry("svc-dup", "11960", "11961", "sync --company company.kofmd --store pub.db")
    assert(exitOf(sync) == 0, sync)

    // Reproduce the 2026-11-07 sequence WITHOUT waiting for a real clock:
    //   1. the slot already POSTED today (a successful publication occurrence
    //      is seeded in the ledger, exactly as the 05:53 post left it);
    //   2. the slot is due again and this run SKIPS (empty research = no
    //      candidate), which is the "miss" that used to schedule a retry.
    // Before the fix the retry was scheduled and, because its instant was
    // still ahead, it generated a SECOND draft and published it.
    runCmd("python3 -c \"import sqlite3,datetime; tz=datetime.timezone(datetime.timedelta(hours=-3)); now=datetime.datetime.now(tz); day=now.strftime('%Y-%m-%d'); t=(now-datetime.timedelta(minutes=1)).strftime('%Y-%m-%dT%H:%M:%S-03:00'); c=sqlite3.connect('" + workDir("svc-dup") + "/pub.db'); c.execute(\\\"update schedule set next_execution=? where name='noon'\\\", (t,)); c.execute(\\\"insert into occurrence (id,recurrence_id,occurrence_time,publication_id,stage,result,detail,started_at,finished_at) values (?,?,?,?,?,?,?,?,?)\\\", ('noon@'+day+'T05:53:00-03:00','noon',day+'T05:53:00-03:00','pub-ja-postado','publication','success','',day+'T05:53:00-03:00',day+'T05:53:00-03:00')); c.commit()\"")

    var s = cliFixturesRetry("svc-dup", "11960", "11961", "start --company company.kofmd --store pub.db")
    assert(exitOf(s) == 0, s)

    var logPath = workDir("svc-dup") + "/home/publisher.log"
    var waited = 0
    while (waited < 90000) {
        var n = runCmd("grep -c 'ja publicou hoje' '" + logPath + "' 2>/dev/null; true")
        if (outOf(n).trim() != "0") {
            break
        }
        runCmd("sleep 2")
        waited = waited + 2000
    }
    var stop = cliFixturesRetry("svc-dup", "11960", "11961", "stop")
    assert(exitOf(stop) == 0, stop)
    forceCleanup("svc-dup")

    var log = outOf(runCmd("cat '" + logPath + "' 2>/dev/null"))
    // The guard fired: the slot had already posted, so the miss was NOT
    // turned into a retry.
    assert(has(log, "ja publicou hoje"), "o guarda de post duplicado nao disparou:\n" + log)
    assert(!has(log, "nova tentativa em"), "o slot ja tinha publicado e mesmo assim agendou retentativa:\n" + log)

    // And the ledger still holds exactly ONE successful publication for the day.
    var count = runCmd("python3 -c \"import sqlite3; c=sqlite3.connect('" + workDir("svc-dup") + "/pub.db'); print(c.execute(\\\"select count(*) from publication where status='published'\\\").fetchone()[0])\"")
    assert(outOf(count).trim() == "0", "nenhuma publicacao nova deveria existir, veio: " + outOf(count))

    stopLm("svc-dup")
    stopResearch("svc-dup")
}
