test "plan: a concessive clause does not excuse a test guarantee either" {
    prepare("pl-embora")
    // "os testes ... sao suficientes para garantir X, EMBORA nao substituam Y".
    // Two gaps at once: the boundary was "embora" (not "mas") and the verb was
    // the infinitive "garantir" (not "garantem"). Measured from the real run of
    // 2026-10-11.
