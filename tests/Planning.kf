test "plan: a projects post may not claim the build was verified" {
    prepare("pl-unverified")
    // The repository analysis records verified_build=false and says "nada foi
    // executado aqui". "o codigo compila" is therefore an unproduced result.
    // Measured from pub-06-00-morning-de2a104a on the real run of 2026-10-11.
    // Distinct from the test-guarantee case: this one claims the build
