// E2E: the PERSONAL profile pipeline (examples/mel.kofmd) — the four daily
// editorial categories (06/12/15/18), the material gate, the lexical
// anti-repetition memory and the size limit, all against a real HTTP fixture
// LM and the real built binary. Nothing here publishes to LinkedIn: `plan`
// stores proposals in REVIEW and the only publish path exercised is the
// offline `--target dryrun`.

String envOr(String key, String dflt) {
    var v = config.env(key)
    if (v != null && v != "") {
        return v
    }
    return dflt
}

String publisherDir() {
    return envOr("KOF_PUBLISHER_DIR", "/home/mel/Documentos/kof-publisher")
}

String classpath() {
    var home = envOr("HOME", "/home/mel")
    var drv = envOr("KOF_SQLITE_JAR", home + "/.kof/deps/org/xerial/sqlite-jdbc/3.53.4.0/sqlite-jdbc-3.53.4.0.jar")
    return envOr("KOF_PUBLISHER_CLASSES", publisherDir() + "/build/classes")
        + ":" + home + "/.local/share/kof/lib/kof.jar:" + drv
}

String workDir(String name) {
    return "/tmp/kof-pub-tests/" + name
}

void prepare(String name) {
    var r = process.run("sh", "-c", "rm -rf '" + workDir(name) + "' && mkdir -p '" + workDir(name) + "'")
    assert(r.exitCode == 0, "prepare " + name + ": " + r.stderr)
}

String runCmd(String cmd) {
    var r = process.run("sh", "-c", cmd + " 2>&1")
    return r.stdout + "||EXIT=" + r.exitCode
}

Int exitOf(String blob) {
    var i = blob.indexOf("||EXIT=")
    if (i < 0) {
        throw "no exit marker"
    }
    return blob.substring(i + 7).toInt()
}

String outOf(String blob) {
    var i = blob.indexOf("||EXIT=")
    return blob.substring(0, i)
}

Bool has(String hay, String needle) {
    return hay.indexOf(needle) >= 0
}

Int countOf(String hay, String needle) {
    return hay.split(needle).length - 1
}

String base(String name) {
    return "KOF_PUBLISHER_HOME='" + workDir(name) + "/home' KOF_PUBLISHER_DRYRUN_DIR='" + workDir(name) + "/dryrun' "
}

String lm(String port) {
    return "KOF_LM_URL=http://127.0.0.1:" + port + " KOF_LM_MODEL=fake-lm KOF_LM_TOKENS=400 KOF_LM_TIMEOUT=25 "
}

String cli(String name, String port, String args) {
    var cmd = "cd '" + workDir(name) + "' && " + base(name) + lm(port) + "java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

String startLm(String name, String port, String mode) {
    runCmd("pkill -f 'fake_lm_persona[l].py " + port + "' || true; true")
    var up = runCmd("{ python3 '" + publisherDir() + "/tests/fake_lm_personal.py' " + port + " " + mode + " > '" + workDir(name) + "/lm.log' 2>&1 & echo $! > '" + workDir(name) + "/lm.pid'; }; sleep 1; curl -s -m 4 http://127.0.0.1:" + port + "/api/tags | grep -c models")
    assert(exitOf(up) == 0 && outOf(up).trim() == "1", up)
    return outOf(up)
}

void stopLm(String name) {
    runCmd("kill $(cat '" + workDir(name) + "/lm.pid') 2>/dev/null || true")
}

// first "pub-..." id in a `list --status <s>` output
String firstIdFor(String name, String port, String status) {
    var o = cli(name, port, "list --status " + status + " --company company.kofmd --store pub.db")
    assert(exitOf(o) == 0, o)
    for (var line in outOf(o).split("\n")) {
        var t = line.trim()
        if (t.startsWith("pub-")) {
            return t.split(" ")[0]
        }
    }
    throw "no publication with status " + status + " in:\n" + outOf(o)
}

test "personal: plan prepares one proposal per category, all in REVIEW, nothing published" {
    prepare("personal-plan")
    var cp = runCmd("cp '" + publisherDir() + "/examples/mel.kofmd' '" + workDir("personal-plan") + "/company.kofmd' && mkdir -p '" + workDir("personal-plan") + "/home'")
    assert(exitOf(cp) == 0, cp)
    startLm("personal-plan", "11581", "distinct")

    // --no-research: the profile's news slot depends on live sources, which is
    // a separate test surface. Offline, the projects/contraponto/observacao
    // slots still run from real material (GitHub digest / registered opinions).
    var p = cli("personal-plan", "11581", "plan --no-research --company company.kofmd --store pub.db")
    assert(exitOf(p) == 0, p)
    var out = outOf(p)
    assert(has(out, "Nada foi publicado"), out)
    for (var clk in listOf("06:00", "12:00", "15:00", "18:00")) {
        assert(has(out, clk), "missing slot " + clk + ":\n" + out)
    }
    // the profile's four editorial FUNCTIONS are all represented (the header
    // prints the function's label, which is what the slot is FOR)
    assert(has(out, "trabalho real e projetos"), out)
    assert(has(out, "noticia de tecnologia"), out)
    assert(has(out, "contraponto tecnico"), out)
    assert(has(out, "observacao, humor e reflexao"), out)
    // offline, the projects slot (no repo analysed yet) and the news slot (no
    // live source) both skip and say so instead of inventing material
    assert(has(out, "trabalho real e projetos]  -> SKIP ----"), out)
    assert(has(out, "noticia de tecnologia]  -> SKIP ----"), out)
    assert(has(out, "2 proposta"), out)

    var rev = cli("personal-plan", "11581", "list --status review --company company.kofmd --store pub.db")
    assert(exitOf(rev) == 0, rev)
    assert(countOf(outOf(rev), "pub-") == 2, rev)

    var pub = cli("personal-plan", "11581", "list --status published --company company.kofmd --store pub.db")
    assert(exitOf(pub) == 0, pub)
    assert(has(outOf(pub), "nenhuma"), pub)

    // assisted flow demonstrated offline: approve one -> publish to dryrun only
    var id = firstIdFor("personal-plan", "11581", "review")
    var app = cli("personal-plan", "11581", "approve " + id + " --company company.kofmd --store pub.db")
    assert(exitOf(app) == 0, app)
    var pubOk = cli("personal-plan", "11581", "publish " + id + " --target dryrun --company company.kofmd --store pub.db")
    assert(exitOf(pubOk) == 0, pubOk)
    assert(has(outOf(pubOk), "publicada"), pubOk)
    var files = runCmd("ls '" + workDir("personal-plan") + "/dryrun' 2>/dev/null | wc -l")
    assert(exitOf(files) == 0 && outOf(files).trim() == "1", files)
    stopLm("personal-plan")
}

test "personal: no material skips honestly, invents nothing" {
    prepare("personal-nomat")
    var company = "# company\nname: Sem Material\n\n# publishing\ntimezone: America/Sao_Paulo\nmode: assisted\ntarget: linkedin\n\n# category morning\nclock: 06:00\nlabel: opiniao\nangle: fale de algo\n\n# editorial\nrequire_material: true\n"
    var w = runCmd("mkdir -p '" + workDir("personal-nomat") + "/home'")
    assert(exitOf(w) == 0, w)
    var f = File(workDir("personal-nomat") + "/company.kofmd")
    f.writeText(company)
    startLm("personal-nomat", "11581", "distinct")

    var p = cli("personal-nomat", "11581", "plan --no-research --company company.kofmd --store pub.db")
    // Zero proposals is a NON-ZERO exit: the command did not produce the day's
    // plan, and a script wrapping it must be able to tell. The message says why.
    assert(exitOf(p) != 0, p)
    assert(has(outOf(p), "SKIP"), outOf(p))
    assert(has(outOf(p), "nenhum projeto com atividade recente analisada"), outOf(p))
    assert(has(outOf(p), "0 proposta(s) em REVIEW"), outOf(p))
    var rev = cli("personal-nomat", "11581", "list --status review --company company.kofmd --store pub.db")
    assert(exitOf(rev) == 0, rev)
    assert(has(outOf(rev), "nenhuma"), rev)
    stopLm("personal-nomat")
}

test "personal: repeated opening is caught by the editorial memory and discarded" {
    prepare("personal-rep")
    // Both slots are contraponto, so they draw from the SAME pool of registered
    // opinions: the second one is guaranteed to be a genuine repeat candidate
    // for the lexical memory to catch.
    var company = "# company\nname: Repetidora\n\n# topics\ntopics:\n  - engenharia de software\n\n# opinions\nopinions:\n  - prefere complexidade justificada a complexidade de moda\n  - desconfia de metrica que mede atividade em vez de resultado\n\n# publishing\ntimezone: America/Sao_Paulo\nmode: assisted\n\n# category morning\nclock: 06:00\nlabel: opiniao\nfunction: contraponto\n\n# category noon\nclock: 12:00\nlabel: experiencia\nfunction: contraponto\n\n# editorial\nrequire_material: true\n"
    var w = runCmd("mkdir -p '" + workDir("personal-rep") + "/home'")
    assert(exitOf(w) == 0, w)
    File(workDir("personal-rep") + "/company.kofmd").writeText(company)
    startLm("personal-rep", "11582", "repeat")

    var p = cli("personal-rep", "11582", "plan --no-research --company company.kofmd --store pub.db")
    assert(exitOf(p) == 0, p)
    assert(has(outOf(p), "abertura repetida"), outOf(p))
    assert(has(outOf(p), "DESCARTADO"), outOf(p))
    var rev = cli("personal-rep", "11582", "list --status review --company company.kofmd --store pub.db")
    assert(exitOf(rev) == 0, rev)
    assert(countOf(outOf(rev), "pub-") == 1, "expected exactly 1 stored proposal:\n" + outOf(rev))
    stopLm("personal-rep")
}

test "personal: max_chars from the editorial section is enforced" {
    prepare("personal-max")
    var company = "# company\nname: Curta\n\n# topics\ntopics:\n  - engenharia\n\n# opinions\nopinions:\n  - prefere complexidade justificada a complexidade de moda\n\n# publishing\ntimezone: America/Sao_Paulo\nmode: assisted\n\n# category morning\nclock: 06:00\nlabel: opiniao\nfunction: contraponto\n\n# editorial\nmax_chars: 120\nrequire_material: true\n"
    var w = runCmd("mkdir -p '" + workDir("personal-max") + "/home'")
    assert(exitOf(w) == 0, w)
    File(workDir("personal-max") + "/company.kofmd").writeText(company)
    startLm("personal-max", "11581", "distinct")

    var p = cli("personal-max", "11581", "plan --no-research --company company.kofmd --store pub.db")
    assert(exitOf(p) != 0, p)
    assert(has(outOf(p), "exceeds 120"), outOf(p))
    stopLm("personal-max")
}
