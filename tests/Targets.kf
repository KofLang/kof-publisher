// E2E: the PUBLISH BOUNDARY — the one place this tool can change the outside
// world. Everything here runs against a LOCAL stub of the LinkedIn REST API in
// an isolated home, so a real post is never a possibility.
//
// Proven here:
//   an assisted profile NEVER reaches the network (the human gate is a state
//   gate, not a convention);
//   a personal-profile URN is refused unless the operator opts in explicitly;
//   publishing as a page actually reaches the API with the right body and
//   leaves the item `published` (the LinkedIn path used to fail JVM
//   verification and could never post at all);
//   a failed publish ends in a TERMINAL state, never stranded in `publishing`.

String envOr(String key, String dflt) {
    var v = config.env(key)
    if (v != null && v != "") {
        return v
    }
    return dflt
}

String publisherDir() {
    return envOr("KOF_PUBLISHER_DIR", "/home/mel/Documentos/kof-publisher")
}

String classpath() {
    var home = envOr("HOME", "/home/mel")
    var drv = envOr("KOF_SQLITE_JAR", home + "/.kof/deps/org/xerial/sqlite-jdbc/3.53.4.0/sqlite-jdbc-3.53.4.0.jar")
    return envOr("KOF_PUBLISHER_CLASSES", publisherDir() + "/build/classes")
        + ":" + home + "/.local/share/kof/lib/kof.jar:" + drv
}

String workDir(String name) {
    return "/tmp/kof-pub-tests/" + name
}

String runCmd(String cmd) {
    var r = process.run("sh", "-c", cmd + " 2>&1")
    return r.stdout + "||EXIT=" + r.exitCode
}

Int exitOf(String blob) {
    var i = blob.indexOf("||EXIT=")
    if (i < 0) {
        throw "no exit marker"
    }
    return blob.substring(i + 7).toInt()
}

String outOf(String blob) {
    var i = blob.indexOf("||EXIT=")
    return blob.substring(0, i)
}

Bool has(String hay, String needle) {
    return hay.indexOf(needle) >= 0
}

// A profile pointing at the LinkedIn target, with enough material to generate.
String targetCompany(String mode) {
    var c = "# company\nname: Mel Santos\n\n# topics\ntopics:\n  - engenharia de software\n\n"
    c = c + "# facts\nfacts:\n  - engenheira de software\n\n"
    c = c + "# publishing\ntimezone: America/Sao_Paulo\nmode: " + mode + "\ntarget: linkedin\n\n"
    c = c + "# editorial\nrequire_material: true\n"
    return c
}

void prepare(String name, String mode) {
    var r = process.run("sh", "-c", "rm -rf '" + workDir(name) + "' && mkdir -p '" + workDir(name) + "/home'")
    assert(r.exitCode == 0, "prepare " + name + ": " + r.stderr)
    File(workDir(name) + "/company.kofmd").writeText(targetCompany(mode))
}

// A LOCAL stand-in for the LinkedIn REST API. It records every POST it gets
// (path, whether an Authorization header was present — never the token itself,
// and the body) to the file named by STUB_LI_LOG, and answers 201 with a share
// id. `chr(10)` is used instead of "\n" so the generated Python has no escape
// ambiguity.
void writeLinkedInStub(String name) {
    var s = "import json,os,sys\n"
    s = s + "from http.server import BaseHTTPRequestHandler,HTTPServer\n"
    s = s + "LOG=os.environ.get('STUB_LI_LOG','/tmp/stub-li.log')\n"
    s = s + "class H(BaseHTTPRequestHandler):\n"
    s = s + "    def _ok(self,body=b'',code=201):\n"
    s = s + "        self.send_response(code)\n"
    s = s + "        self.send_header('Content-Type','application/json')\n"
    s = s + "        self.send_header('Content-Length',str(len(body)))\n"
    s = s + "        self.end_headers()\n"
    s = s + "        self.wfile.write(body)\n"
    s = s + "    def do_GET(self):\n"
    s = s + "        return self._ok(b'ok',200)\n"
    s = s + "    def do_POST(self):\n"
    s = s + "        n=int(self.headers.get('Content-Length','0'))\n"
    s = s + "        b=self.rfile.read(n)\n"
    s = s + "        rec={'method':'POST','path':self.path,'auth':bool(self.headers.get('Authorization')),'body':b.decode('utf-8','replace')}\n"
    s = s + "        f=open(LOG,'a',encoding='utf-8')\n"
    s = s + "        f.write(json.dumps(rec)+chr(10))\n"
    s = s + "        f.close()\n"
    s = s + "        return self._ok(b'{\"id\":\"urn:li:share:stub1\"}',201)\n"
    s = s + "    def log_message(self,*a):\n"
    s = s + "        pass\n"
    s = s + "HTTPServer(('127.0.0.1',int(sys.argv[1])),H).serve_forever()\n"
    File(workDir(name) + "/li_stub.py").writeText(s)
}

void startStub(String name, String port) {
    runCmd("pkill -f 'li_stub.p[y] " + port + "' || true; true")
    runCmd("rm -f '" + workDir(name) + "/li.log'")
    var up = runCmd("cd '" + workDir(name) + "' && { STUB_LI_LOG='" + workDir(name) + "/li.log'"
        + " nohup python3 li_stub.py " + port + " > stub.out 2>&1 & echo $! > li.pid; };"
        + " sleep 1; curl -s -m 4 http://127.0.0.1:" + port + "/health")
    assert(has(outOf(up), "ok"), "linkedin stub did not come up:\n" + up)
}

void stopStub(String name) {
    runCmd("kill $(cat '" + workDir(name) + "/li.pid') 2>/dev/null || true")
}

void startLm(String name, String port) {
    runCmd("pkill -f 'fake_lm_persona[l].py " + port + "' || true; true")
    var up = runCmd("cd '" + workDir(name) + "' && { python3 '" + publisherDir() + "/tests/fake_lm_personal.py' "
        + port + " distinct > lm.log 2>&1 & echo $! > lm.pid; }; sleep 1; curl -s -m 4 http://127.0.0.1:" + port + "/api/tags | grep -c models")
    assert(exitOf(up) == 0 && outOf(up).trim() == "1", "fake LM did not come up:\n" + up)
}

void stopLm(String name) {
    runCmd("kill $(cat '" + workDir(name) + "/lm.pid') 2>/dev/null || true")
}

// How many POSTs the stub received (0 when it never wrote a log).
String postCount(String name) {
    var c = runCmd("test -s '" + workDir(name) + "/li.log' && wc -l < '" + workDir(name) + "/li.log' || echo 0")
    return outOf(c).trim()
}

// The status of the single publication in the queue ("" when there is none).
// `list` needs no LM and no network, so it is called directly.
String onlyStatus(String name, String store) {
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " timeout 60 java -cp '" + classpath() + "' Default.Main list --store " + store + " 2>&1"
    var l = runCmd(cmd)
    for (var line in outOf(l).split("\n")) {
        var t = line.trim()
        if (t.startsWith("pub-")) {
            var open = t.indexOf("[")
            var close = t.indexOf("]")
            if (open >= 0 && close > open) {
                return t.substring(open + 1, close)
            }
        }
    }
    return ""
}

// The publisher talks to the LOCAL stub only: KOF_LINKEDIN_API is overridden, so
// api.linkedin.com is never addressed. The LM also points at a local fixture.
String cli(String name, String liPort, String lmPort, String args) {
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " KOF_LM_URL=http://127.0.0.1:" + lmPort + " KOF_LM_MODEL=fake-lm KOF_LM_TOKENS=800 KOF_LM_TIMEOUT=25"
        + " KOF_LINKEDIN_AUTHOR_URN=urn:li:organization:99999999"
        + " KOF_LINKEDIN_ACCESS_TOKEN=FAKEstub-token-not-real"
        + " KOF_LINKEDIN_API=http://127.0.0.1:" + liPort
        + " timeout 90 java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

String cliAsPerson(String name, String liPort, String lmPort, String allowPersonal, String args) {
    var cmd = "cd '" + workDir(name) + "' && KOF_PUBLISHER_HOME='" + workDir(name) + "/home'"
        + " KOF_LM_URL=http://127.0.0.1:" + lmPort + " KOF_LM_MODEL=fake-lm KOF_LM_TOKENS=800 KOF_LM_TIMEOUT=25"
        + " KOF_LINKEDIN_AUTHOR_URN=urn:li:person:FAKEPERSON"
        + " KOF_LINKEDIN_ALLOW_PERSONAL=" + allowPersonal
        + " KOF_LINKEDIN_ACCESS_TOKEN=FAKEstub-token-not-real"
        + " KOF_LINKEDIN_API=http://127.0.0.1:" + liPort
        + " timeout 90 java -cp '" + classpath() + "' Default.Main " + args + " 2>&1"
    var r = process.run("sh", "-c", cmd)
    return r.stdout + "||EXIT=" + r.exitCode
}

// The human gate: assisted mode must NEVER reach the network.
test "targets: an assisted profile never posts to LinkedIn" {
    prepare("tg-assisted", "assisted")
    writeLinkedInStub("tg-assisted")
    startStub("tg-assisted", "11980")
    startLm("tg-assisted", "11981")

    var g = cli("tg-assisted", "11980", "11981", "generate --topic 'engenharia de software' --company company.kofmd --store pub.db")
    assert(exitOf(g) == 0, g)
    // the draft was produced and parked for a human
    assert(has(outOf(g), "review"), outOf(g))
    assert(onlyStatus("tg-assisted", "pub.db") == "review", "assisted draft did not stay in review")
    // and the API saw nothing at all
    assert(postCount("tg-assisted") == "0", "assisted profile hit the LinkedIn API")

    stopLm("tg-assisted")
    stopStub("tg-assisted")
}

// The personal-profile guard: a personal URN is refused unless the operator
// opted in, and the refusal leaves the item in a TERMINAL state.
test "targets: a personal URN is refused without an explicit opt-in" {
    prepare("tg-personal", "autonomous")
    writeLinkedInStub("tg-personal")
    startStub("tg-personal", "11984")
    startLm("tg-personal", "11985")

    var g = cliAsPerson("tg-personal", "11984", "11985", "false", "generate --topic 'engenharia de software' --publish-ok --company company.kofmd --store pub.db")
    assert(has(outOf(g), "PERFIL PESSOAL"), "personal URN was not refused:\n" + outOf(g))
    assert(postCount("tg-personal") == "0", "a personal URN without opt-in reached the API")
    // AUD-9: the failed item must be actionable, never stranded in `publishing`
    assert(onlyStatus("tg-personal", "pub.db") == "failed", "failed publish did not end in a terminal state:\n" + onlyStatus("tg-personal", "pub.db"))

    stopLm("tg-personal")
    stopStub("tg-personal")
}

// The page path must actually work: one POST, the author URN in the body, and
// the item `published`. (This is the AUD-8 regression: the LinkedIn path used to
// die with a JVM VerifyError before any HTTP call, so it could never post.)
test "targets: publishing as a page reaches the API once and marks the item published" {
    prepare("tg-page", "autonomous")
    writeLinkedInStub("tg-page")
    startStub("tg-page", "11986")
    startLm("tg-page", "11987")

    var g = cli("tg-page", "11986", "11987", "generate --topic 'engenharia de software' --publish-ok --company company.kofmd --store pub.db")
    assert(exitOf(g) == 0, g)
    assert(postCount("tg-page") == "1", "expected exactly one POST to the LinkedIn API")
    assert(onlyStatus("tg-page", "pub.db") == "published", "item did not end published:\n" + g)

    // the request carried the page URN, an auth header and the post text — and
    // never the token value
    var log = runCmd("cat '" + workDir("tg-page") + "/li.log'")
    var body = outOf(log)
    assert(has(body, "urn:li:organization:99999999"), "page URN missing from the request:\n" + body)
    assert(has(body, "\"auth\": true"), "no Authorization header was sent:\n" + body)
    assert(has(body, "commentary"), "the post body was not sent:\n" + body)
    assert(!has(body, "FAKEstub-token-not-real"), "the token leaked into the request log:\n" + body)

    stopLm("tg-page")
    stopStub("tg-page")
}
